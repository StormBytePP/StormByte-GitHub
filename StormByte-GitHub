usage_error() {
	err "$1"
	[[ -n "${2-}" ]] && printf '  usage: %s %s\n' "$SCRIPT_NAME" "$2" >&2
	exit 2
}

_clr_wrap() { printf '%s%s%s' "$1" "$2" "${_CLR_RESET}"; }

_clr_planned() {
	local text low
	text="${1-}"
	low="${text,,}"
	case "$low" in
		"no changes"|keep) _clr_wrap "${_CLR_GREEN}" "$text" ;;
		unresolved*|missing*|error*) _clr_wrap "${_CLR_BOLD_RED}" "$text" ;;
		*) _clr_wrap "${_CLR_BOLD_GREEN}" "$text" ;;
	esac
}

_clr_status_label() {
	case "$1" in
		OK)             _clr_wrap "${_CLR_GREEN}" "$1" ;;
		DIRTY|UNPUSHED) _clr_wrap "${_CLR_BOLD_YELLOW}" "$1" ;;
		DIRTY+UNPUSHED) _clr_wrap "${_CLR_BOLD_RED}" "$1" ;;
		*)              printf '%s' "$1" ;;
	esac
}

_clr_merge_label() {
	case "$1" in
		CLEAN)     _clr_wrap "${_CLR_GREEN}" "$1" ;;
		CONFLICTS) _clr_wrap "${_CLR_BOLD_RED}" "$1" ;;
		*)         printf '%s' "$1" ;;
	esac
}

_clr_ci_status() {
	case "${1,,}" in
		completed) _clr_wrap "${_CLR_GREEN}" "$1" ;;
		in_progress|queued|pending|waiting|requested) _clr_wrap "${_CLR_CYAN}" "$1" ;;
		*) printf '%s' "$1" ;;
	esac
}

_clr_ci_conclusion() {
	case "${1,,}" in
		success) _clr_wrap "${_CLR_GREEN}" "$1" ;;
		failure|cancelled|timed_out|startup_failure) _clr_wrap "${_CLR_BOLD_RED}" "$1" ;;
		-) printf '%s' "$1" ;;
		*) _clr_wrap "${_CLR_BOLD_YELLOW}" "$1" ;;
	esac
}

_idle() {
	printf "  ${_CLR_GREEN}OK${_CLR_RESET} ${_CLR_DIM}│${_CLR_RESET} %s\n" "$*"
}

# =============================================================================
# Walk
# =============================================================================

resolve_repo_dir() {
	local spec="$1" base_root="${2:-$ROOT}" candidate
	candidate="$(path_under_root "$base_root" "$spec")"
	if [[ -d "$candidate" ]]; then
		dir_realpath "$candidate"
	else
		printf '%s\n' "$candidate"
	fi
}

__walk_repos=0
__walk_total=0
__walk_bytes=0

foreach_repo() {
	local callback="$1" target="${2:-}" walk_root="${3:-$ROOT}"
	local dir name repo path

	__walk_repos=0
	__walk_total=0
	__walk_bytes=0
	parse_selection_spec "$target"

	if [[ ${#INCLUDE_ITEMS[@]} -eq 1 && ${#EXCLUDE_ITEMS[@]} -eq 0 ]]; then
		dir="$(resolve_repo_dir "${INCLUDE_ITEMS[0]}" "$walk_root")"
		section "$(basename "$dir")"
		repo="$(git_resolve_repo "$dir" "$OWNER")" || displayError "Target must be a ${OWNER} git repository: $dir"
		LAST_COUNT=0
		LAST_BYTES=0
		"$callback" "$dir" "$repo"
		__walk_total=$((__walk_total + ${LAST_COUNT:-0}))
		__walk_bytes=$((__walk_bytes + ${LAST_BYTES:-0}))
		__walk_repos=1
		return 0
	fi

	shopt -s nullglob
	for path in "$walk_root"/*/; do
		dir="${path%/}"
		name="$(basename "$dir")"
		should_process_item "$name" || continue
		section "$name"
		if [[ ! -d "$dir/.git" && ! -f "$dir/.git" ]]; then
			warn "Not a git repo — skip"
			continue
		fi
		if ! repo="$(git_resolve_repo "$dir" "$OWNER" 2>/dev/null)"; then
			warn "Skip (not a usable ${OWNER} repo)"
			continue
		fi
		LAST_COUNT=0
		LAST_BYTES=0
		"$callback" "$dir" "$repo" || true
		__walk_total=$((__walk_total + ${LAST_COUNT:-0}))
		__walk_bytes=$((__walk_bytes + ${LAST_BYTES:-0}))
		__walk_repos=$((__walk_repos + 1))
	done
}

print_summary() {
	local label="$1" count="$2"
	log ""
	printf '  %s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' "${_CLR_DIM}" "${_CLR_RESET}"
	printf "  ${_CLR_BOLD}DONE${_CLR_RESET}  ${_CLR_DIM}repos:${_CLR_RESET} %s  ${_CLR_DIM}│${_CLR_RESET}  ${_CLR_DIM}%s:${_CLR_RESET} %s\n" \
		"$__walk_repos" "$label" "$count"
	log ""
}

print_summary_sized() {
	local label="$1" count="$2" bytes="$3"
	log ""
	printf '  %s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' "${_CLR_DIM}" "${_CLR_RESET}"
	printf "  ${_CLR_BOLD}DONE${_CLR_RESET}  ${_CLR_DIM}repos:${_CLR_RESET} %s  ${_CLR_DIM}│${_CLR_RESET}  ${_CLR_DIM}%s:${_CLR_RESET} %s  ${_CLR_DIM}│${_CLR_RESET}  ${_CLR_DIM}size:${_CLR_RESET} %s\n" \
		"$__walk_repos" "$label" "$count" "$(human_size "$bytes")"
	log ""
}

