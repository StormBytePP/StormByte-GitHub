cmd_repos_list() {
	local dir name repo branch tag_or_hash path count=0
	info "Root" "$ROOT"
	log ""
	printf "  ${_CLR_DIM}%-28s  %-36s  %-22s  %s${_CLR_RESET}\n" "FOLDER" "REMOTE" "TAG / COMMIT" "BRANCH"
	shopt -s nullglob
	for path in "$ROOT"/*/; do
		dir="${path%/}"
		name="$(basename "$dir")"
		if [[ ! -d "$dir/.git" && ! -f "$dir/.git" ]]; then
			printf "  %-28s  %-36s  %-22s  %s\n" "$name" "-" "-" "-"
			count=$((count + 1))
			continue
		fi
		if ! repo="$(git_resolve_repo "$dir" "$OWNER" 2>/dev/null)"; then
			repo="$(git_remote_repo "$dir" 2>/dev/null || echo "?")"
		fi
		branch="$(git_current_branch "$dir")"
		[[ -z "$branch" ]] && branch="-"
		tag_or_hash="$(git_latest_tag "$dir")"
		if [[ -z "$tag_or_hash" ]]; then
			tag_or_hash="$(git_head_sha "$dir")"
			[[ -z "$tag_or_hash" ]] && tag_or_hash="-"
		fi
		printf "  %-28s  %-36s  %-22s  %s\n" "$name" "$repo" "$tag_or_hash" "$branch"
		count=$((count + 1))
	done
	__walk_repos=$count
	__walk_total=$count
	print_summary "folders listed" "$count"
}

print_size() {
	local file="$1" bytes kib
	if [[ ! -e "$file" ]]; then
		printf '  %-60s  (missing)\n' "$file"
		return
	fi
	bytes="$(wc -c < "$file" | tr -d ' ')"
	kib=$(( (bytes + 1023) / 1024 ))
	printf '  %-60s  %6d KiB\n' "$file" "$kib"
}

dump_files_cpp() {
	local root="$1" dest="$2" base="$3"
	shift 3
	local f rel
	: > "$dest"
	find "$root" -type f \( -name '*.hxx' -o -name '*.h' -o -name '*.cxx' \) \
		! -path '*/.git/*' ! -path '*/build/*' ! -path '*/thirdparty/*' ! -path '*/dist/*' \
		"$@" | sort | while IFS= read -r f; do
			rel="${f#"$base"/}"
			printf '%s\n' "//==============================================================================" "// FILE: $rel" "//==============================================================================" ""
			cat "$f"
			printf '\n\n'
		done >> "$dest"
}

dump_files_cmake() {
	local root="$1" dest="$2" base="$3" f rel
	: > "$dest"
	find "$root" -type f \( \
			-name 'CMakeLists.txt' -o -name '*.cmake' -o -name '*.cmake.in' -o \
			-name '*.sh.in' -o -name '*.bat.in' -o -name '*.cmd.in' \
		\) \
		! -path '*/.git/*' ! -path '*/build/*' ! -path '*/thirdparty/*' \
		! -path '*/dist/*' ! -path '*/pkgconf/*' ! -path '*/tools/extra/pkgconf/*' \
		| sort | while IFS= read -r f; do
			rel="${f#"$base"/}"
			printf '%s\n' "//==============================================================================" \
				"// FILE: $rel (this header does not belong to original code)" \
				"//==============================================================================" ""
			cat "$f"
			printf '\n\n'
		done >> "$dest"
}

split_file() {
	local file="$1" prefix="$2" size_kb="$3" f
	local -a chunks=()
	if [[ ! -s "$file" ]]; then
		log "  (empty file, not split)"
		return
	fi
	split -b "${size_kb}k" --numeric-suffixes=1 --suffix-length=2 "$file" "$prefix"
	shopt -s nullglob
	for f in ${prefix}*; do
		[[ -e "$f" ]] || continue
		[[ "$f" == *.txt ]] && continue
		mv "$f" "${f}.txt"
	done
	chunks=(${prefix}*.txt)
	shopt -u nullglob
	[[ ${#chunks[@]} -eq 0 ]] && { log "  (no chunks)"; return; }
	log "  Generated chunks:"
	for f in "${chunks[@]}"; do
		print_size "$f"
	done
}

cmd_repos_dump() {
	local dir="" chunk_size_kb="" type="c++" arg project out out_test
	for arg in "$@"; do
		if [[ "$arg" == type=* ]]; then
			type="${arg#type=}"
		elif [[ "$arg" =~ ^[0-9]+$ ]]; then
			chunk_size_kb="$arg"
		elif [[ -z "$dir" ]]; then
			dir="$arg"
		else
			usage_error "Unexpected argument: $arg" "repos dump <directory> [chunk_size_kb] [type=c++|type=cmake]"
		fi
	done
	[[ -n "$dir" ]] || usage_error "repos dump requires a directory" "repos dump <directory> [chunk_size_kb] [type=c++|type=cmake]"
	case "$type" in c++|cmake) ;; *) usage_error "Invalid type='$type'" "repos dump <directory> [chunk_size_kb] [type=c++|type=cmake]" ;; esac
	if [[ -n "$chunk_size_kb" ]] && { ! [[ "$chunk_size_kb" =~ ^[0-9]+$ ]] || [[ "$chunk_size_kb" -le 0 ]]; }; then
		displayError "chunk_size_kb must be a positive integer"
	fi

	dir="$(resolve_dir_under "$ROOT" "$dir")"
	project="$(basename "$dir")"
	out="${OUT}/project_${project}.txt"
	out_test="${OUT}/project_${project}_test.txt"
	rm -f "$out" "$out_test"
	rm -f "${OUT}/project_${project}_part_"*.txt
	rm -f "${OUT}/project_${project}_test_part_"*.txt

	info "Project" "$project"
	info "Type" "$type"
	info "Source dir" "$dir"
	info "OUT" "$OUT"

	if [[ "$type" == "cmake" ]]; then
		dump_files_cmake "$dir" "$out" "$dir"
		: > "$out_test"
		log "sources: $out"
		print_size "$out"
		log "tests:   (skipped for type=cmake)"
	else
		dump_files_cpp "$dir" "$out" "$dir" ! -path "$dir/test/*" ! -path "*/test/*"
		if [[ -d "$dir/test" ]]; then
			dump_files_cpp "$dir/test" "$out_test" "$dir"
		else
			: > "$out_test"
			warn "No test directory at $dir/test"
		fi
		log "sources: $out"
		print_size "$out"
		log "tests:   $out_test"
		print_size "$out_test"
	fi

	if [[ -n "$chunk_size_kb" ]]; then
		log ""
		log "=== Splitting sources into ~${chunk_size_kb} KB chunks ==="
		split_file "$out" "${OUT}/project_${project}_part_" "$chunk_size_kb"
		if [[ "$type" == "c++" ]]; then
			log ""
			log "=== Splitting tests into ~${chunk_size_kb} KB chunks ==="
			split_file "$out_test" "${OUT}/project_${project}_test_part_" "$chunk_size_kb"
		fi
	fi
}

cmd_repos_status_one() {
	local dir="$1" repo="$2"
	local branch upstream ahead=0 behind=0 ab dirty=0 unpushed=0 status_label

	info "Path" "$dir"
	info "Remote" "$repo"
	branch="$(git_current_branch "$dir")"
	[[ -z "$branch" ]] && branch="?"
	info "Branch" "$branch"
	if git_is_dirty "$dir"; then
		dirty=1
		info "Working" "dirty"
	else
		info "Working" "clean"
	fi
	if upstream="$(git_upstream_ref "$dir")"; then
		info "Upstream" "$upstream"
		if ab="$(git_ahead_behind "$dir")"; then
			ahead="${ab%% *}"
			behind="${ab##* }"
			[[ "$ahead" =~ ^[0-9]+$ ]] || ahead=0
			[[ "$behind" =~ ^[0-9]+$ ]] || behind=0
			info "Ahead/Behind" "$ahead / $behind"
			[[ "$ahead" -gt 0 ]] && unpushed=1
		else
			info "Ahead/Behind" "?"
			unpushed=1
		fi
	else
		info "Upstream" "none"
		unpushed=1
	fi
	if [[ "$dirty" -eq 1 && "$unpushed" -eq 1 ]]; then
		status_label="DIRTY+UNPUSHED"
	elif [[ "$dirty" -eq 1 ]]; then
		status_label="DIRTY"
	elif [[ "$unpushed" -eq 1 ]]; then
		status_label="UNPUSHED"
	else
		status_label="OK"
	fi
	info "Status" "$(_clr_status_label "$status_label")"
	LAST_COUNT=1
}

cmd_repos_push_one() {
	local dir="$1" repo="$2" branch
	info "Path" "$dir"
	info "Remote" "$repo"
	if ! git_upstream_ref "$dir" >/dev/null; then
		warn "No upstream — skip push"
		LAST_COUNT=0
		return 0
	fi
	branch="$(git_current_branch "$dir")"
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git push"
		LAST_COUNT=1
		return 0
	fi
	if git -C "$dir" push; then
		ok "Pushed $branch"
		LAST_COUNT=1
	else
		warn "Push failed"
		LAST_COUNT=0
	fi
}

cmd_repos_release_list_one() {
	local dir="$1" repo="$2" filter_ver="${3:-}"
	local tag name pre published url entry rest
	local -a releases=() tags=() orphan=()
	local -A release_tags=()
	local count=0 t

	info "Path" "$dir"
	info "Remote" "$repo"
	[[ -n "$filter_ver" ]] && info "Filter" "$(version_plain "$filter_ver")"

	mapfile -t releases < <(gh_release_list "$repo" 200)
	mapfile -t tags < <({
		git -C "$dir" tag -l 2>/dev/null || true
		git -C "$dir" ls-remote --tags --refs origin 2>/dev/null | sed -E 's#.*refs/tags/##' || true
	} | sort -u)

	if [[ ${#releases[@]} -eq 0 ]]; then
		_idle "No GitHub Releases"
	else
		printf "  ${_CLR_DIM}%-20s  %-8s  %-24s  %s${_CLR_RESET}\n" "TAG" "PRE" "PUBLISHED" "TITLE"
		for entry in "${releases[@]}"; do
			tag="${entry%%$'\t'*}"
			rest="${entry#*$'\t'}"
			name="${rest%%$'\t'*}"
			rest="${rest#*$'\t'}"
			pre="${rest%%$'\t'*}"
			rest="${rest#*$'\t'}"
			published="${rest%%$'\t'*}"
			url="${rest#*$'\t'}"
			[[ -z "$tag" ]] && continue
			release_tags["$(version_plain "$tag")"]=1
			if [[ -n "$filter_ver" && "$(version_plain "$tag")" != "$(version_plain "$filter_ver")" ]]; then
				continue
			fi
			printf "  %-20s  %-8s  %-24s  %s\n" "$tag" "$pre" "$published" "$name"
			count=$((count + 1))
		done
	fi

	for t in "${tags[@]}"; do
		[[ -z "$t" ]] && continue
		[[ -n "$filter_ver" && "$(version_plain "$t")" != "$(version_plain "$filter_ver")" ]] && continue
		[[ -n "${release_tags[$(version_plain "$t")]+x}" ]] && continue
		orphan+=("$t")
	done
	if [[ ${#orphan[@]} -gt 0 ]]; then
		info "Tags without a GitHub Release" "${orphan[*]}"
	fi
	ok "Listed $count release(s)"
	LAST_COUNT=$count
}

cmd_repos_release() {
	local spec="" version="" do_list=0 do_delete=0 skip_ci=0
	local dir repo ver_plain tag confirm has_release has_tag recreate=0
	local branch sha last_tag last_plain notes_file notes pre=0

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--list) do_list=1; shift ;;
			--delete) do_delete=1; shift ;;
			--skip-ci) skip_ci=1; shift ;;
			-*) usage_error "Unknown option: $1" "repos release [dir-spec] [version] [--list | --delete | --skip-ci]" ;;
			*)
				if [[ -z "$spec" ]]; then
					spec="$1"
				elif [[ -z "$version" ]]; then
					version="$1"
				else
					usage_error "Unexpected argument: $1" "repos release [dir-spec] [version] [--list | --delete | --skip-ci]"
				fi
				shift
				;;
		esac
	done

	if [[ "$do_list" -eq 1 ]]; then
		if [[ -n "$spec" && "$spec" != '!'* && ! "$(version_is_valid "$spec" && echo 1)" ]]; then
			:
		fi
		if [[ -n "$spec" && -z "$version" ]] && version_is_valid "$spec"; then
			version="$spec"
			spec=""
		fi
		local filter_ver=""
		[[ -n "$version" ]] && filter_ver="$(version_plain "$version")"
		if [[ -n "$spec" && "$spec" != '!'* ]]; then
			dir="$(resolve_repo_dir "$spec" "$ROOT")"
			[[ -d "$dir" ]] || displayError "Directory does not exist: $dir"
			section "$(basename "$dir")"
			repo="$(git_resolve_repo "$dir" "$OWNER")" || displayError "Target must be a ${OWNER} git repository: $dir"
			LAST_COUNT=0
			cmd_repos_release_list_one "$dir" "$repo" "$filter_ver"
			print_summary "releases listed" "$LAST_COUNT"
			return 0
		fi
		__walk_total=0
		foreach_repo cmd_repos_release_list_one "$spec"
		print_summary "releases listed" "$__walk_total"
		return 0
	fi

	[[ -n "$spec" && -n "$version" ]] || usage_error "CREATE/DELETE need <dir> <version>" \
		"repos release <dir> <version> [--delete | --skip-ci]"
	version_is_valid "$version" || displayError "Invalid version: $version (expected e.g. 1.0.0 or 1.0.0-rc.1)"
	ver_plain="$(version_plain "$version")"
	tag="$version"
	dir="$(resolve_repo_dir "$spec" "$ROOT")"
	[[ -d "$dir" ]] || displayError "Directory does not exist: $dir"
	repo="$(git_resolve_repo "$dir" "$OWNER")" || displayError "Target must be a ${OWNER} git repository: $dir"
	section "$(basename "$dir")"
	info "Path" "$dir"
	info "Remote" "$repo"
	info "Version / tag" "$tag"

	if [[ "$do_delete" -eq 1 ]]; then
		has_release=0
		has_tag=0
		gh_release_exists "$repo" "$tag" && has_release=1
		git_tag_exists_local "$dir" "$tag" && has_tag=1
		git_tag_exists_remote "$dir" "$tag" && has_tag=1
		if [[ "$has_release" -eq 0 && "$has_tag" -eq 0 ]]; then
			warn "No GitHub release or tag named $tag — nothing to delete"
			ok "Delete complete (noop)"
			LAST_COUNT=0
			return 0
		fi
		printf '  %sAbout to delete%s\n' "${_CLR_BOLD}" "${_CLR_RESET}"
		printf '    repo:    %s\n' "$repo"
		printf '    tag:     %s\n' "$tag"
		[[ "$has_release" -eq 1 ]] && printf '    release: will remove GitHub Release\n'
		[[ "$has_tag" -eq 1 ]] && printf '    git:     will remove tag (local + origin)\n'
		echo
		printf '  Type %syes%s to continue: ' "${_CLR_BOLD}" "${_CLR_RESET}"
		read -r confirm
		[[ "$confirm" == "yes" ]] || displayError "Aborted (confirmation was not exactly \"yes\")"
		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] would: gh release delete $tag; delete tag local+origin"
			ok "Dry-run complete"
			LAST_COUNT=1
			return 0
		fi
		if [[ "$has_release" -eq 1 ]]; then
			info "GitHub Release" "deleting $tag"
			gh_release_delete "$repo" "$tag" || displayError "gh release delete failed"
		fi
		info "Tag" "deleting $tag (local + origin)"
		git_tag_delete_local_remote "$dir" "$tag"
		ok "Deleted $tag on $repo"
		LAST_COUNT=1
		return 0
	fi

	info "Mode" "CREATE"
	branch="$(git_current_branch "$dir")"
	[[ "$branch" == "master" || "$branch" == "main" ]] || displayError "Must be on master/main (now: $branch)"
	git_is_dirty "$dir" && displayError "Working tree is dirty — commit or stash first"
	notes_file="$(mktemp)"
	if ! git_changelog_extract_notes "$dir/CHANGELOG.md" "$ver_plain" > "$notes_file"; then
		rm -f "$notes_file"
		displayError "CHANGELOG.md has no section for $ver_plain"
	fi
	last_tag="$(git_latest_tag "$dir")"
	if [[ -n "$last_tag" ]]; then
		last_plain="$(version_plain "$last_tag")"
		if version_is_valid "$last_plain" && semver_eq "$ver_plain" "$last_plain"; then
			recreate=1
			warn "Same core version as $last_tag — will delete existing tag/release and recreate"
		fi
	fi
	if git_tag_exists_local "$dir" "$tag" || git_tag_exists_remote "$dir" "$tag"; then
		recreate=1
		warn "Tag $tag already exists — will delete and recreate"
	fi
	if gh_release_exists "$repo" "$tag"; then
		recreate=1
		warn "GitHub release $tag exists — will delete and recreate"
	fi
	sha="$(git_head_sha_full "$dir")"
	info "HEAD" "${sha:0:12}"
	echo
	printf '  %sAbout to release%s\n' "${_CLR_BOLD}" "${_CLR_RESET}"
	printf '    repo:    %s\n' "$repo"
	printf '    tag:     %s\n' "$tag"
	printf '    branch:  %s\n' "$branch"
	[[ "$recreate" -eq 1 ]] && printf '    note:    existing tag/release will be recreated\n'
	echo
	printf '  --- release notes ---\n'
	sed 's/^/  /' "$notes_file"
	echo
	printf '  Type %syes%s to continue: ' "${_CLR_BOLD}" "${_CLR_RESET}"
	read -r confirm
	[[ "$confirm" == "yes" ]] || { rm -f "$notes_file"; displayError "Aborted (confirmation was not exactly \"yes\")"; }

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] pull --rebase, optional delete old tag/release, wait CI, tag, push, gh release create"
		ok "Dry-run complete"
		rm -f "$notes_file"
		LAST_COUNT=1
		return 0
	fi

	info "Sync" "fetch + pull --rebase (superproject only)"
	git -C "$dir" fetch origin || displayError "git fetch failed"
	git -C "$dir" pull --rebase --no-recurse-submodules || displayError "git pull --rebase failed"
	git -C "$dir" submodule update --init --recursive >/dev/null 2>&1 || true
	sha="$(git_head_sha_full "$dir")"

	if [[ "$skip_ci" -eq 0 ]]; then
		info "CI" "waiting for green on $sha"
		if ! gh_wait_ci_success "$repo" "$sha"; then
			rm -f "$notes_file"
			displayError "CI not green — release aborted (nothing tagged)"
		fi
	else
		warn "Skipping CI check (--skip-ci)"
	fi

	if [[ "$recreate" -eq 1 ]]; then
		info "Cleanup" "deleting existing GitHub release and tag $tag"
		gh_release_delete "$repo" "$tag" || true
		git_tag_delete_local_remote "$dir" "$tag"
	fi

	info "Tag" "$tag"
	git -C "$dir" tag -a "$tag" -m "Version $ver_plain released" || displayError "git tag failed"
	info "Push" "branch $branch + tag $tag"
	if ! git -C "$dir" push origin "$branch"; then
		git -C "$dir" tag -d "$tag" >/dev/null 2>&1 || true
		displayError "git push origin $branch failed (local tag removed)"
	fi
	if ! git -C "$dir" push origin "$tag"; then
		displayError "git push origin $tag failed — local tag exists; recover with:
git push origin $tag
gh release create $tag -R $repo --title \"Version $ver_plain\" --notes-file <notes>"
	fi

	version_is_prerelease "$ver_plain" && pre=1
	[[ "$pre" -eq 1 ]] && info "Prerelease" "yes"
	info "GitHub Release" "$tag"
	if ! gh_release_create "$repo" "$tag" "Version $ver_plain" "$notes_file" "$pre"; then
		rm -f "$notes_file"
		displayError "gh release create failed — tag is on origin. Recover with:
gh release create $tag -R $repo --title \"Version $ver_plain\" --notes-file <changelog-section>"
	fi
	rm -f "$notes_file"
	ok "Released $tag → https://github.com/$repo/releases/tag/$tag"
	LAST_COUNT=1
}

cmd_repos() {
	local sub="${1:-}"
	shift || true
	case "$sub" in
		list)   cmd_repos_list ;;
		dump)   cmd_repos_dump "$@" ;;
		status) foreach_repo cmd_repos_status_one "${1:-}"; print_summary "repos checked" "$__walk_repos" ;;
		push)   foreach_repo cmd_repos_push_one "${1:-}"; print_summary "repos pushed" "$__walk_total" ;;
		release) cmd_repos_release "$@" ;;
		*) usage_error "Missing or unknown repos subcommand" "repos list|dump|status|push|release …" ;;
	esac
}

