display_header() {
	local line1="StormByte-GitHub  v${STORMBYTE_GITHUB_VERSION}"
	local line2="Actions · Git · Submodules · Source dump · Releases"
	local inner_w border_mid

	inner_w=${#line1}
	(( ${#line2} > inner_w )) && inner_w=${#line2}
	inner_w=$((inner_w + 4))
	(( inner_w < 50 )) && inner_w=50
	border_mid="$(printf '═%.0s' $(seq 1 "$inner_w"))"

	_sb_center() {
		local text tw total left right
		text="${1-}"
		tw=${#text}
		total=$inner_w
		left=$(( (total - tw) / 2 ))
		(( left < 0 )) && left=0
		right=$(( total - tw - left ))
		(( right < 0 )) && right=0
		printf '%*s%s%*s' "$left" '' "$text" "$right" ''
	}

	printf '\n'
	printf '  %s╔%s╗%s\n' "${_CLR_BOLD_BLUE}" "$border_mid" "${_CLR_RESET}"
	printf '  %s║%s%s%s║%s\n' "${_CLR_BOLD_BLUE}" "${_CLR_RESET}${_CLR_BOLD}" "$(_sb_center "$line1")" "${_CLR_BOLD_BLUE}" "${_CLR_RESET}"
	printf '  %s║%s%s%s║%s\n' "${_CLR_BOLD_BLUE}" "${_CLR_RESET}" "$(_sb_center "$line2")" "${_CLR_BOLD_BLUE}" "${_CLR_RESET}"
	printf '  %s╚%s╝%s\n' "${_CLR_BOLD_BLUE}" "$border_mid" "${_CLR_RESET}"
	printf '\n'
}

display_help() {
	cat <<EOF
