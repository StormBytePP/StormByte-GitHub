cmd_cache_show_one() {
	local dir="$1" repo="$2"
	local count=0 bytes=0 id size key entry rest
	local -a entries=()

	info "Remote" "$repo"
	[[ -n "$CACHE_NAME_FILTER" ]] && info "Filter" "--name $CACHE_NAME_FILTER"
	mapfile -t entries < <(gh_cache_list "$repo" "$PAGE_LIMIT")

	if [[ ${#entries[@]} -eq 0 ]]; then
		_idle "No caches"
		LAST_COUNT=0
		LAST_BYTES=0
		return 0
	fi

	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		size="${rest%%$'\t'*}"
		key="${rest#*$'\t'}"
		[[ -z "$id" ]] && continue
		[[ "$size" =~ ^[0-9]+$ ]] || size=0
		gh_key_matches "$key" "$CACHE_NAME_FILTER" || continue
		printf "  %-12s  %-10s  %s\n" "id=$id" "$(human_size "$size")" "$key"
		count=$((count + 1))
		bytes=$((bytes + size))
	done

	if [[ "$count" -eq 0 ]]; then
		_idle "No caches matched the filter"
	else
		info "Repo total" "$count cache(s), $(human_size "$bytes")"
		ok "Listed $count cache(s)"
	fi
	LAST_COUNT=$count
	LAST_BYTES=$bytes
}

cmd_cache_list_one() {
	local dir="$1" repo="$2"
	local count=0 bytes=0 id size key entry rest
	local -a entries=()

	info "Remote" "$repo"
	[[ -n "$CACHE_NAME_FILTER" ]] && info "Filter" "--name $CACHE_NAME_FILTER"
	mapfile -t entries < <(gh_cache_list "$repo" "$PAGE_LIMIT")

	if [[ ${#entries[@]} -eq 0 ]]; then
		_idle "No caches"
		LAST_COUNT=0
		LAST_BYTES=0
		return 0
	fi

	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		size="${rest%%$'\t'*}"
		key="${rest#*$'\t'}"
		[[ -z "$id" ]] && continue
		[[ "$size" =~ ^[0-9]+$ ]] || size=0
		gh_key_matches "$key" "$CACHE_NAME_FILTER" || continue
		count=$((count + 1))
		bytes=$((bytes + size))
	done

	if [[ "$count" -eq 0 ]]; then
		_idle "No caches matched the filter"
	else
		ok "$count cache(s), $(human_size "$bytes")"
	fi
	LAST_COUNT=$count
	LAST_BYTES=$bytes
}

cmd_cache_delete_one() {
	local dir="$1" repo="$2"
	local deleted=0 page=0 batch id key entry matched_this_page
	local -a entries=()

	info "Remote" "$repo"
	[[ -n "$CACHE_NAME_FILTER" ]] && info "Filter" "--name $CACHE_NAME_FILTER"

	while true; do
		page=$((page + 1))
		if [[ "$MAX_PAGES" -gt 0 && "$page" -gt "$MAX_PAGES" ]]; then
			warn "Reached MAX_PAGES=$MAX_PAGES — stopping this repo"
			break
		fi
		mapfile -t entries < <(gh_cache_list_ids "$repo" "$PAGE_LIMIT")
		batch=${#entries[@]}
		if [[ "$batch" -eq 0 ]]; then
			[[ "$page" -eq 1 ]] && _idle "No caches" || _idle "No more caches"
			break
		fi
		info "Page" "$page ($batch cache(s))"
		matched_this_page=0
		for entry in "${entries[@]}"; do
			id="${entry%%$'\t'*}"
			key="${entry#*$'\t'}"
			[[ -z "$id" ]] && continue
			gh_key_matches "$key" "$CACHE_NAME_FILTER" || continue
			matched_this_page=$((matched_this_page + 1))
			if [[ "$DRY_RUN" == "1" ]]; then
				log "  [dry-run] would delete id=$id key=$key"
				deleted=$((deleted + 1))
				continue
			fi
			log "  delete id=$id key=$key"
			if gh_cache_delete "$repo" "$id"; then
				deleted=$((deleted + 1))
			else
				warn "delete failed for id=$id"
			fi
		done
		[[ -n "$CACHE_NAME_FILTER" && "$matched_this_page" -eq 0 ]] && break
		[[ -z "$CACHE_NAME_FILTER" && "$batch" -lt "$PAGE_LIMIT" ]] && break
		[[ "$DRY_RUN" == "1" ]] && break
	done

	ok "Deleted $deleted cache(s)"
	LAST_COUNT=$deleted
	LAST_BYTES=0
}

cmd_cache() {
	local sub="${1:-}"
	shift || true
	local target=""
	CACHE_NAME_FILTER=""

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--name)
				shift
				[[ $# -gt 0 ]] || usage_error "--name requires a value" \
					"cache show|list|delete [dir-spec] [--name <pattern>]"
				CACHE_NAME_FILTER="$1"
				shift
				;;
			--name=*)
				CACHE_NAME_FILTER="${1#--name=}"
				shift
				;;
			-*)
				usage_error "Unknown option: $1" \
					"cache show|list|delete [dir-spec] [--name <pattern>]"
				;;
			*)
				[[ -z "$target" ]] && target="$1"
				shift
				;;
		esac
	done

	case "$sub" in
		show)   foreach_repo cmd_cache_show_one "$target"; print_summary_sized "caches listed" "$__walk_total" "$__walk_bytes" ;;
		list)   foreach_repo cmd_cache_list_one "$target"; print_summary_sized "caches" "$__walk_total" "$__walk_bytes" ;;
		delete) foreach_repo cmd_cache_delete_one "$target"; print_summary "caches deleted" "$__walk_total" ;;
		*) usage_error "Missing or unknown cache subcommand" \
			"cache show|list|delete [dir-spec] [--name <pattern>]" ;;
	esac
}

