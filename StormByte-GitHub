cmd_git_reset_one() {
	local dir="$1"
	info "Path" "$dir"
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git reset --hard && git clean -fd"
		LAST_COUNT=1
		return 0
	fi
	if git -C "$dir" reset --hard && git -C "$dir" clean -fd; then
		git -C "$dir" submodule foreach --recursive 'git reset --hard && git clean -fd' >/dev/null 2>&1 || true
		git -C "$dir" submodule update --init --recursive >/dev/null 2>&1 || true
		ok "Reset complete"
		LAST_COUNT=1
	else
		warn "Reset failed"
		LAST_COUNT=0
	fi
}

cmd_git_pull_one() {
	local dir="$1"
	info "Path" "$dir"
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git fetch origin && git pull --rebase --no-recurse-submodules"
		LAST_COUNT=1
		return 0
	fi
	if git -C "$dir" fetch origin && git -C "$dir" pull --rebase --no-recurse-submodules; then
		git -C "$dir" submodule update --init --recursive >/dev/null 2>&1 || true
		ok "Pull complete ($(git_head_sha "$dir"))"
		LAST_COUNT=1
	else
		warn "Pull failed"
		LAST_COUNT=0
	fi
}

cmd_git_sync_one() { cmd_git_pull_one "$@"; }

cmd_git() {
	local sub="${1:-}" target="${2:-}"
	case "$sub" in
		reset) foreach_repo cmd_git_reset_one "$target"; print_summary "repos reset" "$__walk_total" ;;
		pull)  foreach_repo cmd_git_pull_one "$target"; print_summary "repos pulled" "$__walk_total" ;;
		sync)  foreach_repo cmd_git_sync_one "$target"; print_summary "repos synced" "$__walk_total" ;;
		*) usage_error "Missing or unknown git subcommand" "git reset|pull|sync [dir-spec]" ;;
	esac
}

