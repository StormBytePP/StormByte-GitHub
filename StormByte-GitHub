cmd_ci_stop_one() {
	local dir="$1" repo="$2"
	local branch cancelled=0 id status workflow title entry rest
	local -a entries=()

	LAST_COUNT=0
	info "Remote" "$repo"
	branch="$(git_current_branch "$dir")"
	[[ -z "$branch" ]] && { err "Cannot resolve current branch"; return 1; }
	info "Branch" "$branch"

	mapfile -t entries < <(gh_run_list_active "$repo" "$branch" "$PAGE_LIMIT")
	if [[ ${#entries[@]} -eq 0 ]]; then
		_idle "No active runs on $branch"
		return 0
	fi
	info "Found" "${#entries[@]} unique active run(s)"

	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		status="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		workflow="${rest%%$'\t'*}"
		title="${rest#*$'\t'}"
		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] would cancel: $workflow id=$id"
			cancelled=$((cancelled + 1))
			continue
		fi
		log "  cancel: $workflow id=$id"
		if gh_run_cancel "$repo" "$id"; then
			cancelled=$((cancelled + 1))
		else
			warn "cancel failed for id=$id"
		fi
	done
	LAST_COUNT=$cancelled
	ok "Cancelled $cancelled unique workflow run(s)"
}

cmd_ci_start_one() {
	local dir="$1" repo="$2"
	local branch sha rerun=0 skipped=0
	local id status conclusion head_sha workflow title entry rest
	local -a entries=()
	local -A seen_workflow=()

	LAST_COUNT=0
	info "Remote" "$repo"
	branch="$(git_current_branch "$dir")"
	sha="$(git_head_sha_full "$dir")"
	[[ -z "$branch" || -z "$sha" ]] && { err "Cannot resolve branch/HEAD"; return 1; }
	info "Branch" "$branch"
	info "HEAD" "$sha"
	[[ "$ONLY_FAILED" == "1" ]] && info "Filter" "--failed"

	mapfile -t entries < <(gh_run_list_for_start "$repo" "$branch" "$sha" "$PAGE_LIMIT")
	if [[ ${#entries[@]} -eq 0 ]]; then
		warn "No workflow runs found"
		ok "No workflows re-run"
		return 0
	fi

	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		status="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		conclusion="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		head_sha="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		workflow="${rest%%$'\t'*}"
		title="${rest#*$'\t'}"
		[[ -z "$id" ]] && continue
		[[ -n "$workflow" && -n "${seen_workflow[$workflow]+x}" ]] && continue
		[[ -n "$workflow" ]] && seen_workflow["$workflow"]=1
		[[ "$RUN_LIMIT" -gt 0 && "$rerun" -ge "$RUN_LIMIT" ]] && break
		case "$status" in
			in_progress|queued|pending|waiting|requested)
				log "  skip (already active): $workflow"
				skipped=$((skipped + 1))
				continue
				;;
		esac
		if [[ "$ONLY_FAILED" == "1" ]] && ! gh_run_is_failed "$conclusion"; then
			skipped=$((skipped + 1))
			continue
		fi
		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] Re-run: $workflow id=$id"
			rerun=$((rerun + 1))
			continue
		fi
		log "  Re-run: $workflow id=$id"
		if gh_run_rerun "$repo" "$id"; then
			rerun=$((rerun + 1))
		else
			warn "rerun failed for id=$id"
		fi
	done
	LAST_COUNT=$rerun
	ok "Re-run $rerun workflow(s) (skipped=$skipped)"
}

cmd_ci_restart_one() {
	cmd_ci_stop_one "$1" "$2"
	[[ "$DRY_RUN" != "1" ]] && sleep 2
	cmd_ci_start_one "$1" "$2"
}

cmd_ci_status_one() {
	local dir="$1" repo="$2" branch
	local id status conclusion workflow title entry rest
	local -a entries=()

	LAST_COUNT=0
	info "Remote" "$repo"
	branch="$(git_current_branch "$dir")"
	[[ -z "$branch" ]] && { err "Cannot resolve current branch"; return 1; }
	info "Branch" "$branch"
	mapfile -t entries < <(gh_run_list_recent "$repo" "$branch" 15)
	if [[ ${#entries[@]} -eq 0 ]]; then
		_idle "No recent runs"
		return 0
	fi
	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		status="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		conclusion="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		workflow="${rest%%$'\t'*}"
		title="${rest#*$'\t'}"
		printf "  %-12s  %-12s  %-20s  %s\n" \
			"$(_clr_ci_status "$status")" "$(_clr_ci_conclusion "$conclusion")" "$workflow" "$title"
		LAST_COUNT=$((LAST_COUNT + 1))
	done
	ok "Listed recent runs"
}

cmd_ci() {
	local sub="${1:-}"
	shift || true
	local target="" arg
	for arg in "$@"; do
		case "$arg" in
			--failed) ONLY_FAILED=1 ;;
			*) [[ -z "$target" ]] && target="$arg" ;;
		esac
	done
	case "$sub" in
		stop)     foreach_repo cmd_ci_stop_one "$target"; print_summary "runs cancelled" "$__walk_total" ;;
		start)    foreach_repo cmd_ci_start_one "$target"; print_summary "workflows re-run" "$__walk_total" ;;
		restart)  foreach_repo cmd_ci_restart_one "$target"; print_summary "workflows re-run" "$__walk_total" ;;
		status)   foreach_repo cmd_ci_status_one "$target"; print_summary "repos checked" "$__walk_repos" ;;
		*) usage_error "Missing or unknown ci subcommand" "ci stop|start|restart|status [dir-spec] [--failed]" ;;
	esac
}

# =============================================================================
# Submodule update order
# =============================================================================

canonical_repo_id() { git_canonical_repo_id "$1"; }

urls_from_gitmodules_file() {
	local file="$1"
	[[ -f "$file" ]] || return 0
	git config --file "$file" --list 2>/dev/null | sed -n 's/^submodule\..*\.url=//p' || true
}

collect_dep_ids_from() {
	local dir="$1" file url id
	[[ -d "$dir" ]] || return 0
	while IFS= read -r -d '' file; do
		while IFS= read -r url; do
			[[ -z "$url" ]] && continue
			id="$(git_canonical_repo_id "$url" 2>/dev/null)" || continue
			printf '%s\n' "$id"
		done < <(urls_from_gitmodules_file "$file")
	done < <(find "$dir" -type f -name .gitmodules ! -path '*/.git/*' -print0 2>/dev/null)
}

build_update_order() {
	local dir name repo_disp id
	local -a nodes=()
	local -A deps=()
	local -A id_to_folder=()

	shopt -s nullglob
	for dir in "$ROOT"/*/; do
		dir="${dir%/}"
		[[ -d "$dir/.git" || -f "$dir/.git" ]] || continue
		repo_disp="$(git_resolve_repo "$dir" "$OWNER" 2>/dev/null)" || continue
		id="$(git_canonical_repo_id "https://github.com/${repo_disp}.git")" || continue
		name="$(basename "$dir")"
		if [[ -n "${id_to_folder[$id]+x}" ]]; then
			warn "Duplicate clone of $id — keeping first"
			continue
		fi
		id_to_folder["$id"]="$name"
		nodes+=("$id")
		deps["$id"]=""
	done
	[[ ${#nodes[@]} -eq 0 ]] && return 0

	for id in "${nodes[@]}"; do
		dir="$ROOT/${id_to_folder[$id]}"
		while IFS= read -r dep_id; do
			[[ -z "$dep_id" || "$dep_id" == "$id" ]] && continue
			if [[ -n "${id_to_folder[$dep_id]+x}" ]]; then
				case " ${deps[$id]:-} " in
					*" $dep_id "*) ;;
					*) deps["$id"]="${deps[$id]:+${deps[$id]} }$dep_id" ;;
				esac
			fi
		done < <(collect_dep_ids_from "$dir" | sort -u)
	done

	local -a ordered_ids
	mapfile -t ordered_ids < <(topological_sort nodes deps)
	for id in "${ordered_ids[@]}"; do
		printf '%s\n' "${id_to_folder[$id]}"
	done
}

run_q() {
	local out rc
	set +e
	out="$("$@" 2>&1)"
	rc=$?
	set -e
	if [[ "$rc" -ne 0 ]]; then
		err "Command failed: $*"
		err "Exit code: $rc"
		printf '%s\n' "$out" | tail -n 40 >&2
		return "$rc"
	fi
	return 0
}

cmd_submodules_init_one() {
	local dir="$1"
	info "Path" "$dir"
	if [[ ! -f "$dir/.gitmodules" ]]; then
		_idle "No .gitmodules — nothing to init"
		LAST_COUNT=0
		return 0
	fi
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git submodule update --init --recursive"
		LAST_COUNT=1
		return 0
	fi
	if git -C "$dir" submodule update --init --recursive; then
		ok "Submodules initialized"
		LAST_COUNT=1
	else
		warn "init failed"
		LAST_COUNT=0
	fi
}

cmd_submodules_deinit_one() {
	local dir="$1"
	info "Path" "$dir"
	if [[ ! -f "$dir/.gitmodules" ]]; then
		_idle "No .gitmodules — nothing to deinit"
		LAST_COUNT=0
		return 0
	fi
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git submodule deinit --all -f"
		LAST_COUNT=1
		return 0
	fi
	if git -C "$dir" submodule deinit --all -f; then
		ok "Submodules deinitialized"
		LAST_COUNT=1
	else
		warn "deinit failed"
		LAST_COUNT=0
	fi
}

commit_submodules_if_needed() {
	local dir="$1" name
	name="$(basename "$dir")"
	if ! git_is_dirty "$dir"; then
		_idle "No changes"
		return 1
	fi
	log "  Changes detected:"
	git -C "$dir" status --short | sed 's/^/    /'
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would commit (no push)"
		return 0
	fi
	run_q git -C "$dir" add -A
	if git -C "$dir" diff --cached --quiet; then
		warn "Dirty worktree but nothing staged; skipping commit"
		git -C "$dir" restore --staged . >/dev/null 2>&1 || true
		return 1
	fi
	if ! git -C "$dir" commit -m "chore: update dependencies" >/dev/null; then
		err "git commit failed in $name"
		return 1
	fi
	ok "Commit $(git_head_sha "$dir") (not pushed)"
}

cmd_submodules_update_one() {
	local dir="$1" repo="$2"
	local stashed=0
	local sm_name sm_path sm_url abs short
	local action kind current planned target sha
	local n_upd=0 n_re=0 n_unres=0 n_mod=0 i_mod=0
	local -a plan_name=() plan_path=() plan_cur=() plan_new=()
	local -a plan_action=() plan_kind=() plan_target=()
	local -a shadow_repos=()
	local i reply sha_new got latest latest_sha prefix tag_sha br_sha pin_label
	local plan_line pin_id latest_id
	local heads="${GIT_SHADOW_HEADS:-refs/sb-gh/heads}"

	prefix="${GIT_SHADOW_TAGS:-refs/sb-gh/tags}"

	_sm_trim() {
		local s="${1:-}"
		s="${s//$'\r'/}"
		s="${s//$'\n'/}"
		s="${s#"${s%%[![:space:]]*}"}"
		s="${s%"${s##*[![:space:]]}"}"
		printf '%s' "$s"
	}

	_sm_parse_id() {
		git_pin_parse "${1:-}" 2>/dev/null | cut -f1-5
		return 0
	}

	_sm_hint() {
		printf '\r\033[K  Analyzing %s (%s/%s)…' "$1" "$2" "$3" >&2
	}

	_sm_hint_clear() {
		printf '\r\033[K' >&2
	}

	_sm_shadow_cleanup() {
		local r
		for r in "${shadow_repos[@]}"; do
			git_shadow_delete "$r"
		done
	}

	_sm_cheap_current() {
		local repo="$1" out kind label sha
		[[ -d "$repo" ]] || { printf '%s' ""; return 0; }
		IFS=$'\t' read -r kind label sha < <(git_sm_classify "$dir" "$sm_name" "$repo" 2>/dev/null || true)
		sha="$(_sm_trim "$sha")"
		label="$(_sm_trim "$label")"
		if [[ "$kind" == "tag" || "$kind" == "branch" ]] && [[ -n "$label" ]]; then
			if [[ -n "$sha" ]]; then
				printf '%s (%s)' "$label" "${sha:0:7}"
			else
				printf '%s' "$label"
			fi
		elif [[ -n "$sha" ]]; then
			printf 'sha:%s' "${sha:0:7}"
		else
			printf '%s' ""
		fi
	}

	info "Path" "$dir"
	info "Remote" "$repo"
	LAST_COUNT=0

	if [[ ! -f "$dir/.gitmodules" ]]; then
		_idle "No .gitmodules — nothing to update"
		return 0
	fi

	if [[ "$DRY_RUN" != "1" ]]; then
		if git_stash_if_dirty "$dir" "StormByte-GitHub auto-stash before submodules update"; then
			stashed=1
			ok "Parent changes stashed"
		fi
	fi

	git -C "$dir" fetch origin --prune >/dev/null 2>&1 || true

	n_mod=0
	while IFS=$'\t' read -r sm_name sm_path sm_url; do
		[[ -z "$sm_name" || -z "$sm_path" ]] && continue
		_sm_module_wanted "$sm_name" "$sm_path" || continue
		n_mod=$((n_mod + 1))
	done < <(git_gitmodules_list "$dir")
	(( n_mod == 0 )) && n_mod=1

	i_mod=0
	while IFS=$'\t' read -r sm_name sm_path sm_url; do
		[[ -z "$sm_name" || -z "$sm_path" ]] && continue
		abs="$dir/$sm_path"
		action="keep"
		kind="sha"
		current=""
		planned="No changes"
		target=""
		sha=""
		pin_label=""
		latest=""
		latest_sha=""
		pin_id=""
		latest_id=""
		plan_line=""

		if ! _sm_module_wanted "$sm_name" "$sm_path"; then
			current="$(_sm_cheap_current "$abs")"
			plan_name+=("$sm_name")
			plan_path+=("$sm_path")
			plan_cur+=("$current")
			plan_new+=("No changes")
			plan_action+=("keep")
			plan_kind+=("sha")
			plan_target+=("")
			continue
		fi

		i_mod=$((i_mod + 1))
		_sm_hint "$sm_name" "$i_mod" "$n_mod"

		if [[ "$DRY_RUN" != "1" ]]; then
			if ! git -C "$dir" submodule update --init -- "$sm_path" >/dev/null 2>&1; then
				_sm_hint_clear
				warn "init failed for $sm_path"
				continue
			fi
		fi

		if [[ ! -d "$abs" ]]; then
			_sm_hint_clear
			warn "missing work tree for $sm_path"
			continue
		fi

		shadow_repos+=("$abs")
		if ! git_shadow_fetch "$abs"; then
			_sm_hint_clear
			warn "shadow fetch failed for $sm_path"
		fi

		plan_line="$(git_sm_plan "$dir" "$sm_name" "$abs")" || plan_line=""
		IFS=$'\x1f' read -r action kind current planned target sha _ <<<"${plan_line//$'\t'/$'\x1f'}"
		action="$(_sm_trim "$action")"
		kind="$(_sm_trim "$kind")"
		current="$(_sm_trim "$current")"
		planned="$(_sm_trim "$planned")"
		target="$(_sm_trim "$target")"
		sha="$(_sm_trim "$sha")"

		if [[ "$action" == "error" ]]; then
			_sm_hint_clear
			err "${planned:-plan failed} for ${sm_name}"
			_sm_shadow_cleanup
			if [[ "$stashed" -eq 1 ]]; then
				git_stash_pop_safe "$dir" >/dev/null 2>&1 || true
			fi
			return 1
		fi

		pin_label="$(_sm_trim "$(git_exact_tag_at_sha "$abs" "$sha" 2>/dev/null || true)")"
		pin_label="$(_sm_trim "$(git_ref_basename "$pin_label")")"
		if [[ -z "$pin_label" && "$current" != sha:* && -n "$current" ]]; then
			pin_label="$(_sm_trim "${current%% (*)}")"
		fi

		if [[ -n "${SM_TAG:-}" ]]; then
			tag_sha="$(git_peel_ref "$abs" "${prefix}/${SM_TAG}" 2>/dev/null \
				|| git_peel_ref "$abs" "refs/tags/${SM_TAG}" 2>/dev/null \
				|| true)"
			tag_sha="$(_sm_trim "$tag_sha")"
			if [[ -z "$tag_sha" ]]; then
				action="skip"
				kind="tag"
				planned="UNRESOLVED (no tag ${SM_TAG})"
				target=""
				n_unres=$((n_unres + 1))
			elif [[ -n "$sha" && "$tag_sha" == "$sha" ]]; then
				action="keep"
				planned="No changes"
				target=""
			else
				action="update"
				kind="tag"
				planned="$SM_TAG"
				target="$SM_TAG"
				n_upd=$((n_upd + 1))
			fi
		elif [[ -n "${SM_BRANCH:-}" ]]; then
			br_sha="$(git_peel_ref "$abs" "${heads}/${SM_BRANCH}" 2>/dev/null \
				|| git_peel_ref "$abs" "refs/remotes/origin/${SM_BRANCH}" 2>/dev/null \
				|| true)"
			br_sha="$(_sm_trim "$br_sha")"
			if [[ -z "$br_sha" ]]; then
				action="skip"
				kind="branch"
				planned="UNRESOLVED (no branch ${SM_BRANCH})"
				target=""
				n_unres=$((n_unres + 1))
			elif [[ -n "$sha" && "$br_sha" == "$sha" ]]; then
				action="keep"
				planned="No changes"
				target=""
			else
				action="update"
				kind="branch"
				planned="$SM_BRANCH"
				target="$SM_BRANCH"
				n_upd=$((n_upd + 1))
			fi
		elif [[ "${SM_LATEST:-0}" == "1" && "$kind" == "branch" ]]; then
			if [[ "$action" == "update" ]]; then
				n_upd=$((n_upd + 1))
			elif [[ "$action" == "rerelease" ]]; then
				n_re=$((n_re + 1))
			elif [[ "$action" == "skip" ]]; then
				n_unres=$((n_unres + 1))
			fi
		elif [[ "${SM_LATEST:-0}" == "1" ]]; then
			latest="$(_sm_trim "$(git_pin_latest_recognised "$abs" "$prefix" "$pin_label" 2>/dev/null || true)")"
			latest="$(_sm_trim "$(git_ref_basename "$latest")")"
			latest_sha=""
			if [[ -n "$latest" ]]; then
				latest_sha="$(_sm_trim "$(git_peel_ref "$abs" "refs/tags/${latest}" 2>/dev/null \
					|| git_peel_ref "$abs" "${prefix}/${latest}" 2>/dev/null \
					|| git_peel_ref "$abs" "$latest" 2>/dev/null || true)")"
			fi
			pin_id="$(_sm_parse_id "$pin_label" || true)"
			latest_id="$(_sm_parse_id "$latest" || true)"
			if [[ -z "$latest" ]]; then
				action="keep"
				planned="No changes"
				target=""
			elif [[ -n "$pin_label" && "$latest" == "$pin_label" ]]; then
				action="keep"
				planned="No changes"
				target=""
			else
				action="update"
				kind="tag"
				planned="$latest"
				target="$latest"
				n_upd=$((n_upd + 1))
			fi
		else
			if [[ "$action" == "update" && "$kind" == "tag" && -n "$target" ]]; then
				latest="$(_sm_trim "$(git_pin_latest_in_family "$abs" "$target" "$prefix" 2>/dev/null || true)")"
				if [[ -n "$latest" ]]; then
					planned="$latest"
					target="$latest"
				fi
			fi

			if [[ "$action" == "skip" ]]; then
				_sm_hint_clear
				reply="$(_sm_prompt_ref "$abs" "${current:-$sm_name}" "${planned:-unresolved}")" || reply=""
				if [[ -n "$reply" ]]; then
					if git_peel_ref "$abs" "${heads}/${reply}" >/dev/null 2>&1 \
						|| git_peel_ref "$abs" "refs/remotes/origin/${reply}" >/dev/null 2>&1; then
						action="update"
						kind="branch"
						planned="$reply"
						target="$reply"
						n_upd=$((n_upd + 1))
					else
						action="update"
						kind="tag"
						planned="$reply"
						target="$reply"
						n_upd=$((n_upd + 1))
					fi
				else
					n_unres=$((n_unres + 1))
				fi
			elif [[ "$action" == "update" ]]; then
				n_upd=$((n_upd + 1))
			elif [[ "$action" == "rerelease" ]]; then
				n_re=$((n_re + 1))
			fi
		fi

		plan_name+=("$sm_name")
		plan_path+=("$sm_path")
		plan_cur+=("$current")
		plan_new+=("$planned")
		plan_action+=("$action")
		plan_kind+=("$kind")
		plan_target+=("$target")
	done < <(git_gitmodules_list "$dir")
	_sm_hint_clear

	print_columns --header MODULE CURRENT PLANNED
	for i in "${!plan_name[@]}"; do
		print_columns "${plan_name[$i]}" "${plan_cur[$i]}" "$(_clr_planned "${plan_new[$i]}")"
	done

	info "Plan" "${n_upd} update(s), ${n_re} re-release(s), ${n_unres} unresolved"
	[[ "${SM_CONFIRM:-0}" == "1" ]] && info "Mode" "--confirm"
	[[ "${SM_LATEST:-0}" == "1" ]] && info "Mode" "--latest"
	[[ -n "${SM_MODULE:-}" ]] && info "Module" "$SM_MODULE"
	((${#SM_MODULE_EXCL[@]} > 0)) && info "Module exclude" "${SM_MODULE_EXCL[*]}"
	[[ -n "${SM_TAG:-}" ]] && info "Tag" "$SM_TAG"
	[[ -n "${SM_BRANCH:-}" ]] && info "Branch" "$SM_BRANCH"

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] no checkout"
		LAST_COUNT=0
		_sm_shadow_cleanup
		if [[ "$stashed" -eq 1 ]]; then
			git_stash_pop_safe "$dir" >/dev/null 2>&1 || true
		fi
		return 0
	fi

	if [[ "${SM_CONFIRM:-0}" != "1" ]] && is_tty; then
		if (( n_upd + n_re > 0 )); then
			if ! confirm_yes "Apply this plan?"; then
				warn "Aborted"
				_sm_shadow_cleanup
				if [[ "$stashed" -eq 1 ]]; then
					git_stash_pop_safe "$dir" >/dev/null 2>&1 || true
				fi
				return 0
			fi
		fi
	fi

	for i in "${!plan_name[@]}"; do
		action="${plan_action[$i]}"
		kind="${plan_kind[$i]}"
		target="${plan_target[$i]}"
		abs="$dir/${plan_path[$i]}"
		[[ "$action" == "keep" || "$action" == "skip" || -z "$target" ]] && continue
		if [[ "$kind" == "branch" ]]; then
			if ! git_sm_checkout_branch "$abs" "$target"; then
				warn "checkout origin/${target} failed for ${plan_name[$i]}"
				continue
			fi
		else
			if ! git_sm_checkout_tag "$abs" "$target"; then
				warn "checkout ${target} failed for ${plan_name[$i]}"
				continue
			fi
		fi
		sha_new="$(git -C "$abs" rev-parse HEAD)"
		if ! git -C "$dir" update-index --cacheinfo "160000,${sha_new},${plan_path[$i]}"; then
			warn "update-index ${plan_path[$i]} failed for ${plan_name[$i]}"
			continue
		fi
		got="$(git -C "$dir" rev-parse ":${plan_path[$i]}" 2>/dev/null || true)"
		if [[ "$got" != "$sha_new" ]]; then
			err "gitlink not staged for ${plan_name[$i]} (want ${sha_new:0:7}, index ${got:0:7})"
			continue
		fi
		short="$(git_head_sha "$abs")"
		ok "${plan_name[$i]} → ${short} (${plan_new[$i]})"
	done

	info "Nested" "synchronized to recorded SHAs"
	if git_sm_update_nested "$dir" >/dev/null 2>&1; then
		ok "Nested submodules synchronized to recorded SHAs"
	else
		warn "nested submodule update had errors (pins may be incomplete)"
	fi

	if commit_submodules_if_needed "$dir"; then
		LAST_COUNT=1
	else
		LAST_COUNT=0
	fi

	_sm_shadow_cleanup

	if [[ "$stashed" -eq 1 ]]; then
		log "  Restoring parent stash..."
		if git_stash_pop_safe "$dir"; then
			ok "Parent stash restored"
		else
			warn "stash pop had conflicts. Parent changes remain in the stash (git stash list)."
			warn "Resolve them, then: git stash drop"
		fi
	fi
}

cmd_submodules_list_one() {
	local dir="$1" repo="$2" name path url count=0
	info "Path" "$dir"
	info "Remote" "$repo"
	if ! git_has_submodules "$dir"; then
		info "Submodules" "none"
		LAST_COUNT=0
		return 0
	fi
	printf "  ${_CLR_DIM}%-36s  %-40s  %s${_CLR_RESET}\n" "NAME" "PATH" "URL"
	while IFS=$'\t' read -r name path url; do
		[[ -z "$name" ]] && continue
		printf "  %-36s  %-40s  %s\n" "$name" "$path" "$url"
		count=$((count + 1))
	done < <(git_gitmodules_list "$dir")
	info "Count" "$count"
	ok "Listed $count submodule(s)"
	LAST_COUNT=$count
}

cmd_submodules_add() {
	local name="" dir url path repo
	local -a pos=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--name) shift; [[ $# -gt 0 ]] || usage_error "--name requires a value" "submodules add <dir> <URL> <path> --name <name>"; name="$1"; shift ;;
			--name=*) name="${1#--name=}"; shift ;;
			-*) usage_error "Unknown option: $1" "submodules add <dir> <URL> <path> --name <name>" ;;
			*) pos+=("$1"); shift ;;
		esac
	done
	[[ -n "$name" ]] || usage_error "Missing required --name" "submodules add <dir> <URL> <path> --name <name>"
	[[ ${#pos[@]} -eq 3 ]] || usage_error "Expected <dir> <URL> <path> (got ${#pos[@]} positional args)" \
		"submodules add <dir> <URL> <path> --name <name>"
	dir="$(resolve_dir_under "$ROOT" "${pos[0]}")"
	url="${pos[1]}"
	path="${pos[2]}"
	repo="$(git_resolve_repo "$dir" "$OWNER")" || displayError "Target must be a ${OWNER} git repository: $dir"
	git_submodule_path_is_safe "$path" || displayError "Invalid path '$path' (must be relative to the repo and must not contain '..')"
	section "$(basename "$dir")"
	info "Path" "$dir"
	info "Remote" "$repo"
	info "Add" "$name → $path"
	info "URL" "$url"
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git submodule add --name $name $url $path"
		return 0
	fi
	if git -C "$dir" submodule add --name "$name" "$url" "$path"; then
		ok "Submodule added (not committed)"
	else
		displayError "git submodule add failed"
	fi
}

cmd_submodules_delete() {
	local dir repo name_sel="" url_sel="" path_sel="" selectors=0 name path url
	local -a pos=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--name) shift; name_sel="${1:-}"; shift || true ;;
			--name=*) name_sel="${1#--name=}"; shift ;;
			--url)  shift; url_sel="${1:-}"; shift || true ;;
			--url=*) url_sel="${1#--url=}"; shift ;;
			--path) shift; path_sel="${1:-}"; shift || true ;;
			--path=*) path_sel="${1#--path=}"; shift ;;
			-*) usage_error "Unknown option: $1" \
				"submodules delete <dir> (--name <name> | --url <url> | --path <path>)" ;;
			*) pos+=("$1"); shift ;;
		esac
	done
	[[ ${#pos[@]} -eq 1 ]] || usage_error "Expected exactly one <dir> (got ${#pos[@]})" \
		"submodules delete <dir> (--name <name> | --url <url> | --path <path>)"
	dir="$(resolve_dir_under "$ROOT" "${pos[0]}")"
	repo="$(git_resolve_repo "$dir" "$OWNER")" || displayError "Target must be a ${OWNER} git repository: $dir"
	[[ -n "$name_sel" ]] && selectors=$((selectors + 1))
	[[ -n "$url_sel"  ]] && selectors=$((selectors + 1))
	[[ -n "$path_sel" ]] && selectors=$((selectors + 1))
	[[ "$selectors" -eq 1 ]] || usage_error "Exactly one of --name, --url or --path is required" \
		"submodules delete <dir> (--name <name> | --url <url> | --path <path>)"

	if [[ -n "$name_sel" ]]; then
		IFS=$'\t' read -r name path url < <(git_gitmodules_find_by_name "$dir" "$name_sel") \
			|| displayError "No submodule named '$name_sel'"
	elif [[ -n "$url_sel" ]]; then
		IFS=$'\t' read -r name path url < <(git_gitmodules_find_by_url "$dir" "$url_sel") \
			|| displayError "No submodule with URL '$url_sel'"
	else
		IFS=$'\t' read -r name path url < <(git_gitmodules_find_by_path "$dir" "$path_sel") \
			|| displayError "No submodule at path '$path_sel'"
	fi

	section "$(basename "$dir")"
	info "Path" "$dir"
	info "Remote" "$repo"
	info "Delete" "$name ($path)"
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would deinit/remove $name and delete $path"
		return 0
	fi
	git -C "$dir" submodule deinit -f -- "$path" >/dev/null 2>&1 || true
	git -C "$dir" rm -f -- "$path" >/dev/null 2>&1 || true
	rm -rf "$dir/$path" "$dir/.git/modules/$name" 2>/dev/null || true
	ok "Submodule removed (not committed)"
}

_sm_details_wrap() {
	local indent="$1"
	shift
	local width=72
	local col=${#indent} word shown line=""

	if [[ $# -eq 0 ]]; then
		printf '%s%s\n' "$indent" "—"
		return 0
	fi
	line="$indent"
	col=${#indent}
	for word in "$@"; do
		shown="$word"
		if (( col + ${#shown} + 2 > width && col > ${#indent} )); then
			printf '%s\n' "$line"
			line="${indent}${shown}"
			col=$(( ${#indent} + ${#shown} ))
		else
			if [[ "$line" == "$indent" ]]; then
				line="${indent}${shown}"
				col=$(( ${#indent} + ${#shown} ))
			else
				line="${line}  ${shown}"
				col=$((col + 2 + ${#shown}))
			fi
		fi
	done
	printf '%s\n' "$line"
}

_sm_prompt_ref() {
	local repo="$1" current="$2" hint="${3:-}"
	local reply=""
	if [[ "${SM_CONFIRM:-0}" == "1" ]] || ! is_tty; then
		return 1
	fi
	if [[ -n "$hint" ]]; then
		warn "Unresolved pin '${current}' (${hint}). Type a ref, or Enter to skip."
	else
		warn "Unresolved pin '${current}'. Type a ref, or Enter to skip."
	fi
	if read_input "Ref" reply && [[ -n "$reply" ]]; then
		printf '%s\n' "$reply"
		return 0
	fi
	return 1
}

_sm_module_wanted() {
	local name="$1" path="$2" e
	if [[ -n "${SM_MODULE:-}" ]]; then
		[[ "$name" == "$SM_MODULE" || "$path" == "$SM_MODULE" ]]
		return
	fi
	if ((${#SM_MODULE_EXCL[@]} == 0)); then
		return 0
	fi
	for e in "${SM_MODULE_EXCL[@]}"; do
		[[ -z "$e" ]] && continue
		if [[ "$name" == "$e" || "$path" == "$e" ]]; then
			return 1
		fi
	done
	return 0
}

_sm_parse_module_flag() {
	local spec="$1" part
	SM_MODULE=""
	SM_MODULE_EXCL=()
	[[ -n "$spec" ]] || return 0
	if [[ "$spec" == !* ]]; then
		IFS='+' read -ra part <<< "$spec"
		for spec in "${part[@]}"; do
			spec="${spec#!}"
			[[ -n "$spec" ]] && SM_MODULE_EXCL+=("$spec")
		done
		return 0
	fi
	SM_MODULE="$spec"
}

cmd_submodules_details_one() {
	local dir="$1" repo="$2"
	local sm_name sm_path sm_url abs
	local name url pin_shown latest_shown pin_raw latest_raw
	local tag br shown count=0 matched=0 seed
	local -a shadow_repos=() tags=() branches=() wrap_items=()
	local prefix="${GIT_SHADOW_TAGS:-refs/sb-gh/tags}"

	_sm_details_cleanup() {
		local r
		for r in "${shadow_repos[@]}"; do
			git_shadow_delete "$r"
		done
	}

	info "Path" "$dir"
	info "Remote" "$repo"
	LAST_COUNT=0

	if ! git_has_submodules "$dir"; then
		info "Submodules" "none"
		return 0
	fi

	printf "  ${_CLR_DIM}%-28s  %-36s  %-18s  %s${_CLR_RESET}\n" \
		"NAME" "URL" "PIN" "LATEST"

	while IFS=$'\t' read -r sm_name sm_path sm_url; do
		[[ -z "$sm_name" || -z "$sm_path" ]] && continue
		if ! _sm_module_wanted "$sm_name" "$sm_path"; then
			continue
		fi
		matched=$((matched + 1))
		abs="$dir/$sm_path"
		if [[ ! -d "$abs" ]]; then
			warn "missing work tree for $sm_path"
			printf "  %-28s  %-36s  %-18s  %s\n" "$sm_name" "$sm_url" "—" "—"
			count=$((count + 1))
			continue
		fi

		shadow_repos+=("$abs")
		if ! git_shadow_fetch "$abs"; then
			warn "shadow fetch failed for $sm_path"
		fi

		IFS=$'\t' read -r name url pin_shown latest_shown pin_raw latest_raw \
			< <(git_sm_details_line "$dir" "$sm_name" "$abs")

		if [[ -n "$latest_raw" && "$pin_raw" != "$latest_raw" ]]; then
			latest_shown="$(_clr_wrap "${_CLR_BOLD_GREEN}" "$latest_shown")"
		else
			latest_shown="$(_clr_wrap "${_CLR_GREEN}" "$latest_shown")"
		fi

		printf "  %-28s  %-36s  %-18s  %s\n" \
			"$name" "$url" "$pin_shown" "$latest_shown"
		count=$((count + 1))

		if [[ "${SM_ALL:-0}" != "1" ]]; then
			continue
		fi

		seed="$pin_raw"
		if ! git_pin_parse "$seed" >/dev/null 2>&1; then
			seed="$latest_raw"
		fi
		mapfile -t tags < <(git_sm_details_trunk_tags "$abs" "$prefix" "$seed")
		wrap_items=()
		printf "      ${_CLR_DIM}tags on master${_CLR_RESET}\n"
		if ((${#tags[@]} == 0)); then
			_sm_details_wrap "          "
		else
			for tag in "${tags[@]}"; do
				shown="$(git_pin_display_label "$tag")"
				if [[ "$tag" == "$pin_raw" ]]; then
					shown="*$shown"
					shown="$(_clr_wrap "${_CLR_BOLD_GREEN}" "$shown")"
				fi
				wrap_items+=("$shown")
			done
			_sm_details_wrap "          " "${wrap_items[@]}"
		fi

		mapfile -t branches < <(git_sm_details_origin_branches "$abs")
		wrap_items=()
		printf "      ${_CLR_DIM}branches${_CLR_RESET}\n"
		if ((${#branches[@]} == 0)); then
			_sm_details_wrap "          "
		else
			for br in "${branches[@]}"; do
				shown="$br"
				if [[ "$br" == "$pin_raw" ]]; then
					shown="*$shown"
					shown="$(_clr_wrap "${_CLR_BOLD_GREEN}" "$shown")"
				fi
				wrap_items+=("$shown")
			done
			_sm_details_wrap "          " "${wrap_items[@]}"
		fi
	done < <(git_gitmodules_list "$dir")

	_sm_details_cleanup

	if [[ -n "${SM_MODULE:-}" && "$matched" -eq 0 ]]; then
		warn "No first-level module named or pathed '${SM_MODULE}'"
	fi
	info "Count" "$count"
	ok "Details for $count submodule(s)"
	LAST_COUNT=$count
}

cmd_submodules() {
	local sub="${1:-}"
	shift || true
	local target=""
	local name dir repo arg
	local -a ordered=() rest=()
	local module_spec=""
	local usage_sm="submodules init|deinit|update|list|details [dir-spec] [--confirm] [--latest] [--all] [--module <name|path|!spec>] [--tag <tag>] [--branch <branch>] | add … | delete …"

	if [[ -z "$sub" ]]; then
		usage_error "Missing submodules subcommand" "$usage_sm"
	fi

	case "$sub" in
		add)
			cmd_submodules_add "$@"
			return
			;;
		delete)
			cmd_submodules_delete "$@"
			return
			;;
	esac

	SM_CONFIRM=0
	SM_LATEST=0
	SM_ALL=0
	SM_TAG=""
	SM_BRANCH=""
	SM_MODULE=""
	SM_MODULE_EXCL=()

	while [[ $# -gt 0 ]]; do
		arg="$1"
		shift
		case "$arg" in
			--confirm) SM_CONFIRM=1 ;;
			--latest)  SM_LATEST=1 ;;
			--all)     SM_ALL=1 ;;
			--module)
				[[ $# -gt 0 ]] || usage_error "--module requires a value" "$usage_sm"
				module_spec="$1"
				shift
				;;
			--module=*)
				module_spec="${arg#--module=}"
				;;
			--tag)
				[[ $# -gt 0 ]] || usage_error "--tag requires a value" "$usage_sm"
				SM_TAG="$1"
				shift
				;;
			--tag=*)
				SM_TAG="${arg#--tag=}"
				;;
			--branch)
				[[ $# -gt 0 ]] || usage_error "--branch requires a value" "$usage_sm"
				SM_BRANCH="$1"
				shift
				;;
			--branch=*)
				SM_BRANCH="${arg#--branch=}"
				;;
			-*)
				usage_error "Unknown option: $arg" "$usage_sm"
				;;
			*)
				rest+=("$arg")
				;;
		esac
	done
	target="${rest[0]:-}"
	_sm_parse_module_flag "$module_spec"

	if [[ -n "$SM_TAG" && -n "$SM_BRANCH" ]]; then
		usage_error "--tag and --branch are mutually exclusive" "$usage_sm"
	fi
	if [[ -n "$SM_TAG" ]]; then
		[[ "$sub" == "update" ]] || usage_error "--tag is only valid for submodules update" "$usage_sm"
		[[ -n "$SM_MODULE" ]] || usage_error "--tag requires --module <name|path> (not an exclusion)" "$usage_sm"
	fi
	if [[ -n "$SM_BRANCH" ]]; then
		[[ "$sub" == "update" ]] || usage_error "--branch is only valid for submodules update" "$usage_sm"
		[[ -n "$SM_MODULE" ]] || usage_error "--branch requires --module <name|path> (not an exclusion)" "$usage_sm"
	fi

	case "$sub" in
		init)
			foreach_repo cmd_submodules_init_one "$target"
			print_summary "repos initialized" "$__walk_total"
			;;
		deinit)
			foreach_repo cmd_submodules_deinit_one "$target"
			print_summary "repos deinitialized" "$__walk_total"
			;;
		update)
			if [[ -n "$target" ]]; then
				foreach_repo cmd_submodules_update_one "$target"
				print_summary "repos updated" "$__walk_total"
			else
				mapfile -t ordered < <(build_update_order)
				if [[ ${#ordered[@]} -eq 0 ]]; then
					warn "No eligible repositories under $ROOT"
					__walk_repos=0
					__walk_total=0
					print_summary "repos updated" 0
					return 0
				fi
				info "Update order" "$(IFS=','; echo "${ordered[*]}")"
				__walk_repos=0
				__walk_total=0
				for name in "${ordered[@]}"; do
					dir="$ROOT/$name"
					section "$name"
					if ! repo="$(git_resolve_repo "$dir" "$OWNER" 2>/dev/null)"; then
						warn "Skip (not a usable ${OWNER} repo)"
						continue
					fi
					LAST_COUNT=0
					cmd_submodules_update_one "$dir" "$repo" || true
					__walk_total=$((__walk_total + ${LAST_COUNT:-0}))
					__walk_repos=$((__walk_repos + 1))
				done
				print_summary "repos updated" "$__walk_total"
			fi
			;;
		list)
			foreach_repo cmd_submodules_list_one "$target"
			print_summary "submodules listed" "$__walk_total"
			;;
		details)
			foreach_repo cmd_submodules_details_one "$target"
			print_summary "submodules detailed" "$__walk_total"
			;;
		*)
			usage_error "Unknown submodules subcommand: $sub" "$usage_sm"
			;;
	esac
}

