cmd_clone_all() {
	local name dir cloned=0 skipped=0
	local -a repos=()
	info "Owner" "$OWNER"
	info "Target" "$ROOT"
	mapfile -t repos < <(gh_repo_list_public "$OWNER" 1000)
	if [[ ${#repos[@]} -eq 0 ]]; then
		warn "No public repositories found for $OWNER"
		return 0
	fi
	for name in "${repos[@]}"; do
		dir="$ROOT/$name"
		if [[ -d "$dir" ]]; then
			log "  skip (exists): $name"
			skipped=$((skipped + 1))
			continue
		fi
		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] would clone $OWNER/$name"
			cloned=$((cloned + 1))
			continue
		fi
		log "  cloning $OWNER/$name ..."
		if gh_repo_clone "$OWNER/$name" "$dir"; then
			ok "Cloned $name"
			cloned=$((cloned + 1))
		else
			warn "Failed to clone $name"
		fi
	done
	__walk_repos=$cloned
	print_summary "cloned" "$cloned"
	info "Skipped (already present)" "$skipped"
}

cmd_search() {
	local query="${1:-}" target="${2:-}"
	[[ -z "$query" ]] && usage_error "search requires a text query" "search <text> [dir-spec]"
	SEARCH_QUERY="$query"
	cmd_search_one() {
		local dir="$1" repo="$2"
		info "Remote" "$repo"
		info "Query" "$SEARCH_QUERY"
		if command -v rg >/dev/null 2>&1; then
			rg -n --color always -S "$SEARCH_QUERY" "$dir" \
				--glob '!.git/*' --glob '!build/*' --glob '!thirdparty/*' --glob '!dist/*' \
				2>/dev/null || true
		else
			grep -RIn --color=always \
				--exclude-dir=.git --exclude-dir=build --exclude-dir=thirdparty --exclude-dir=dist \
				"$SEARCH_QUERY" "$dir" 2>/dev/null || true
		fi
		ok "Search finished"
		LAST_COUNT=1
	}
	foreach_repo cmd_search_one "$target"
	print_summary "repos searched" "$__walk_repos"
}

cmd_fork_status_one() {
	local dir="$1" repo="$2" behind ahead behind_ahead
	info "Remote" "$repo"
	if ! gh_is_fork "$repo"; then
		info "Fork" "no"
		_idle "Not a fork"
		LAST_COUNT=0
		return 0
	fi
	info "Fork" "yes"
	if behind_ahead="$(gh_fork_compare "$repo" 2>/dev/null)"; then
		behind="${behind_ahead%% *}"
		ahead="${behind_ahead##* }"
		info "Behind/Ahead" "${behind:-?} / ${ahead:-?}"
	else
		info "Behind/Ahead" "?"
	fi
	ok "Fork status done"
	LAST_COUNT=1
}

cmd_fork_branch_status_one() {
	local dir="$1" repo="$2" branch count=0 note tip merge_label
	local -a branches=()
	info "Path" "$dir"
	info "Remote" "$repo"
	if ! git -C "$dir" rev-parse --verify 'master^{commit}' >/dev/null 2>&1; then
		warn "No local master branch — cannot check mergeability"
		LAST_COUNT=0
		return 0
	fi
	mapfile -t branches < <(
		git -C "$dir" for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null | grep -vx 'master' || true
	)
	if [[ ${#branches[@]} -eq 0 ]]; then
		info "Branches" "no branches other than master"
		_idle "Nothing to check"
		LAST_COUNT=0
		return 0
	fi
	printf "  ${_CLR_DIM}%-36s  %-12s  %s${_CLR_RESET}\n" "BRANCH" "MERGE→master" "NOTE"
	for branch in "${branches[@]}"; do
		[[ -z "$branch" ]] && continue
		note=""
		tip="$branch"
		if git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/${branch}" 2>/dev/null; then
			tip="origin/${branch}"
			if ! git -C "$dir" rev-parse --verify "$branch^{commit}" >/dev/null 2>&1; then
				note="no local tip"
			elif [[ "$(git -C "$dir" rev-parse "$branch^{commit}")" != "$(git -C "$dir" rev-parse "origin/${branch}^{commit}")" ]]; then
				note="local differs from origin"
			fi
		else
			if git -C "$dir" for-each-ref --format='%(refname)' "refs/remotes/*/${branch}" 2>/dev/null | grep -q .; then
				tip="$(git -C "$dir" for-each-ref --format='%(refname:short)' "refs/remotes/*/${branch}" 2>/dev/null | head -n1)"
			else
				note="local-only (not pushed)"
				tip="$branch"
			fi
		fi
		if git_merge_tree_clean "$dir" "master" "$tip"; then
			merge_label="CLEAN"
		else
			merge_label="CONFLICTS"
		fi
		printf "  %-36s  %-12s  %s\n" "$branch" "$(_clr_merge_label "$merge_label")" "$note"
		count=$((count + 1))
	done
	info "Checked" "$count branch(es)"
	ok "Branch status done"
	LAST_COUNT=$count
}

cmd_fork_sync_one() {
	local dir="$1" repo="$2" behind=0 ahead=0 behind_ahead
	info "Remote" "$repo"
	if ! gh_is_fork "$repo"; then
		err "Not a fork: $repo — refusing to sync"
		return 1
	fi
	if behind_ahead="$(gh_fork_compare "$repo" 2>/dev/null)"; then
		behind="${behind_ahead%% *}"
		ahead="${behind_ahead##* }"
		[[ "$behind" =~ ^[0-9]+$ ]] || behind=0
		[[ "$ahead"  =~ ^[0-9]+$ ]] || ahead=0
	fi
	if [[ "$behind" -eq 0 ]]; then
		_idle "Already up to date with upstream (behind=$behind, ahead=$ahead) — skip"
		LAST_COUNT=0
		return 0
	fi
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would sync ONLY master ($behind commits behind, $ahead ahead)"
		LAST_COUNT=1
		return 0
	fi
	if gh_fork_sync_master "$dir" "$repo"; then
		ok "master synced with upstream (was $behind behind)"
		LAST_COUNT=1
	else
		warn "fork sync failed"
		LAST_COUNT=0
	fi
}

cmd_fork() {
	local sub="${1:-}" target="${2:-}" effective
	effective="$(fork_effective_root)"
	info "Fork root" "$effective"
	case "$sub" in
		status)        foreach_repo cmd_fork_status_one "$target" "$effective"; print_summary "forks checked" "$__walk_total" ;;
		sync)          foreach_repo cmd_fork_sync_one "$target" "$effective"; print_summary "forks synced" "$__walk_total" ;;
		branch-status) foreach_repo cmd_fork_branch_status_one "$target" "$effective"; print_summary "branches checked" "$__walk_total" ;;
		*) usage_error "Missing or unknown fork subcommand" "fork status|sync|branch-status [dir-spec]" ;;
	esac
}

# =============================================================================
# test
# =============================================================================

cmd_test() {
	local sub="${1:-}"
	shift || true
	case "$sub" in
		asan|tsan) _cmd_test_dispatch "$sub" "$@" ;;
		*) usage_error "Missing or unknown test subcommand" \
			"test asan|tsan [dir-spec] [--builddir DIR] [--testdir DIR] [--outfile FILE] [--cmake-options \"opts\"] [--executable PATH] [--test REGEX] [--asan-options \"opts\"] [--tsan-options \"opts\"] [--verbose]" ;;
	esac
}

_cmd_test_dispatch() {
	local kind="$1"
	shift
	local target="" builddir="build-${kind}" testdir="" outfile=""
	local cmake_opts="-DENABLE_TEST=ON" executable="" test_regex=""
	local asan_opts="abort_on_error=1:halt_on_error=1:detect_leaks=1:symbolize=1:print_stacktrace=1"
	local tsan_opts="abort_on_error=1:halt_on_error=1:symbolize=1:print_stacktrace=1"
	local verbose=0

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--builddir) shift; [[ $# -gt 0 ]] || usage_error "--builddir requires a value" "test ${kind} …"; builddir="$1"; shift ;;
			--builddir=*) builddir="${1#--builddir=}"; shift ;;
			--testdir) shift; [[ $# -gt 0 ]] || usage_error "--testdir requires a value" "test ${kind} …"; testdir="$1"; shift ;;
			--testdir=*) testdir="${1#--testdir=}"; shift ;;
			--outfile) shift; [[ $# -gt 0 ]] || usage_error "--outfile requires a value" "test ${kind} …"; outfile="$1"; shift ;;
			--outfile=*) outfile="${1#--outfile=}"; shift ;;
			--cmake-options) shift; [[ $# -gt 0 ]] || usage_error "--cmake-options requires a value" "test ${kind} …"; cmake_opts="$1"; shift ;;
			--cmake-options=*) cmake_opts="${1#--cmake-options=}"; shift ;;
			--executable) shift; [[ $# -gt 0 ]] || usage_error "--executable requires a value" "test ${kind} …"; executable="$1"; shift ;;
			--executable=*) executable="${1#--executable=}"; shift ;;
			--test) shift; [[ $# -gt 0 ]] || usage_error "--test requires a value" "test ${kind} …"; test_regex="$1"; shift ;;
			--test=*) test_regex="${1#--test=}"; shift ;;
			--asan-options) shift; [[ $# -gt 0 ]] || usage_error "--asan-options requires a value" "test ${kind} …"; asan_opts="$1"; shift ;;
			--asan-options=*) asan_opts="${1#--asan-options=}"; shift ;;
			--tsan-options) shift; [[ $# -gt 0 ]] || usage_error "--tsan-options requires a value" "test ${kind} …"; tsan_opts="$1"; shift ;;
			--tsan-options=*) tsan_opts="${1#--tsan-options=}"; shift ;;
			--verbose) verbose=1; shift ;;
			-*) usage_error "Unknown option: $1" "test asan|tsan [dir-spec] [options]" ;;
			*)
				if [[ -z "$target" ]]; then target="$1"; shift
				else usage_error "Unexpected argument: $1" "test ${kind} [dir-spec] [options]"; fi
				;;
		esac
	done

	_TEST_KIND="$kind"
	_TEST_BUILDDIR="$builddir"
	_TEST_TESTDIR="$testdir"
	_TEST_OUTFILE="$outfile"
	_TEST_CMAKE_OPTS="$cmake_opts"
	_TEST_EXECUTABLE="$executable"
	_TEST_REGEX="$test_regex"
	_TEST_ASAN_OPTS="$asan_opts"
	_TEST_TSAN_OPTS="$tsan_opts"
	_TEST_VERBOSE="$verbose"
	foreach_repo _cmd_test_one "$target"
	print_summary "repos tested" "$__walk_repos"
}

_cmd_test_one() {
	local dir="$1" repo="$2"
	local kind="$_TEST_KIND" builddir="$_TEST_BUILDDIR" testdir="$_TEST_TESTDIR"
	local outfile="$_TEST_OUTFILE" cmake_opts="$_TEST_CMAKE_OPTS"
	local executable="$_TEST_EXECUTABLE" test_regex="$_TEST_REGEX"
	local asan_opts="$_TEST_ASAN_OPTS" tsan_opts="$_TEST_TSAN_OPTS" verbose="$_TEST_VERBOSE"
	local name build_abs test_abs out_file rc=0
	local -a cmake_cmd=() cmake_extra=() ctest_cmd=()

	name="$(basename "$dir")"
	[[ -z "$testdir" ]] && testdir="${builddir}/test"
	[[ -z "$outfile" ]] && out_file="/tmp/${name}_${kind}_report.txt" || out_file="$outfile"
	build_abs="$(cd "$dir" && realpath -m "$builddir")"
	test_abs="$(cd "$dir" && realpath -m "$testdir")"

	info "Remote" "$repo"
	info "Kind" "${kind^^}"
	info "Build dir" "$build_abs"
	info "Test dir" "$test_abs"
	info "Outfile" "$out_file"
	[[ -n "$executable" ]] && info "Executable" "$executable"
	[[ -n "$test_regex" ]] && info "ctest -R" "$test_regex"
	[[ "$verbose" -eq 1 ]] && info "Verbose" "yes"
	info "CMake opts" "$cmake_opts"

	if [[ -e "$build_abs" ]]; then
		err "Build directory already exists (safety): $build_abs — skip"
		LAST_COUNT=0
		return 0
	fi
	trap "rm -rf -- $(printf '%q' "$build_abs")" RETURN

	cmake_cmd=(cmake -S "$dir" -B "$build_abs" -DCMAKE_BUILD_TYPE=Debug)
	if [[ "$kind" == "asan" ]]; then
		cmake_cmd+=(-DCMAKE_C_FLAGS="-fsanitize=address -fno-omit-frame-pointer" -DCMAKE_CXX_FLAGS="-fsanitize=address -fno-omit-frame-pointer")
	else
		cmake_cmd+=(-DCMAKE_C_FLAGS="-fsanitize=thread -fno-omit-frame-pointer" -DCMAKE_CXX_FLAGS="-fsanitize=thread -fno-omit-frame-pointer")
	fi
	if [[ -n "$cmake_opts" ]]; then
		# shellcheck disable=SC2206
		cmake_extra=($cmake_opts)
		cmake_cmd+=("${cmake_extra[@]}")
	fi

	info "Configure" "cmake"
	if ! "${cmake_cmd[@]}" >"$out_file" 2>&1; then
		err "cmake configure failed — see $out_file"
		LAST_COUNT=0
		return 0
	fi
	info "Build" "cmake --build"
	if ! cmake --build "$build_abs" -j"$(nproc 2>/dev/null || echo 4)" >>"$out_file" 2>&1; then
		err "cmake build failed — see $out_file"
		LAST_COUNT=0
		return 0
	fi

	if [[ "$kind" == "asan" ]]; then
		export ASAN_OPTIONS="$asan_opts"
	else
		export TSAN_OPTIONS="$tsan_opts"
	fi

	if [[ -n "$executable" ]]; then
		info "Run" "$executable"
		if ! (cd "$dir" && "$executable") >>"$out_file" 2>&1; then
			rc=1
		fi
	else
		ctest_cmd=(ctest --test-dir "$test_abs" --output-on-failure)
		[[ "$verbose" -eq 1 ]] && ctest_cmd+=(-V)
		[[ -n "$test_regex" ]] && ctest_cmd+=(-R "$test_regex")
		info "Run" "ctest"
		if ! "${ctest_cmd[@]}" >>"$out_file" 2>&1; then
			rc=1
		fi
	fi

	if [[ "$rc" -eq 0 ]]; then
		ok "${kind^^} tests passed — report $out_file"
		LAST_COUNT=1
	else
		err "${kind^^} tests failed — report $out_file"
		LAST_COUNT=0
	fi
}

# =============================================================================
# main
# =============================================================================

main() {
	local cmd="${1:-}"
	shift || true

	display_header
	if [[ -z "$cmd" || "$cmd" == "help" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
		display_help
		return 0
	fi

	require_cmd git gh jq
	load_or_create_config
	gh_require

	case "$cmd" in
		cache)      cmd_cache "$@" ;;
		ci)         cmd_ci "$@" ;;
		submodules) cmd_submodules "$@" ;;
		git)        cmd_git "$@" ;;
		repos)      cmd_repos "$@" ;;
		clone-all)  cmd_clone_all ;;
		search)     cmd_search "$@" ;;
		fork)       cmd_fork "$@" ;;
		test)       cmd_test "$@" ;;
		*) usage_error "Unknown command: $cmd" \
			"help | cache | ci | submodules | git | repos | clone-all | search | fork | test" ;;
	esac
}

main "$@"
