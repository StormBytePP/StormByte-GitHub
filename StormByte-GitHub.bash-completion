# StormByte-GitHub.bash-completion
# Bash completion for StormByte-GitHub 1.1.0
#
# Install as:
#   /usr/share/bash-completion/completions/StormByte-GitHub
#   or
#   /etc/bash_completion.d/StormByte-GitHub
#
# Keep in sync with StormByte-GitHub CLI

_StormByte_GitHub() {
	local cur prev cword cmd sub
	local -a words
	local -a top_cmds cache_subs ci_subs submodules_subs git_subs repos_subs fork_subs test_subs dump_extra

	COMPREPLY=()

	if declare -F _get_comp_words_by_ref >/dev/null 2>&1; then
		_get_comp_words_by_ref -n : cur prev words cword
	else
		local _old_wb="$COMP_WORDBREAKS"
		COMP_WORDBREAKS=${COMP_WORDBREAKS//:}
		cur="${COMP_WORDS[COMP_CWORD]}"
		prev="${COMP_WORDS[COMP_CWORD - 1]}"
		cword=$COMP_CWORD
		words=("${COMP_WORDS[@]}")
		COMP_WORDBREAKS="$_old_wb"
	fi

	top_cmds=(
		help -h --help
		cache
		ci
		submodules
		git
		repos
		clone-all
		search
		fork
		test
	)

	cache_subs=(show list delete)
	ci_subs=(stop start restart status)
	submodules_subs=(init deinit update list add delete)
	git_subs=(reset pull sync)
	repos_subs=(list dump status push release)
	fork_subs=(status sync branch-status)
	test_subs=(asan tsan)
	dump_extra=('type=c++' 'type=cmake' 50 100 200 500)

	_sb_github_has_word() {
		local needle="$1"
		local i
		for ((i = 1; i < cword; i++)); do
			[[ "${words[i]}" == "$needle" ]] && return 0
		done
		return 1
	}

	_sb_github_collapse_slashes() {
		local p="$1"
		while [[ "$p" == *//* ]]; do
			p="${p//\/\//\/}"
		done
		printf '%s' "$p"
	}

	_sb_github_strip_trailing_slash() {
		local p="$1"
		[[ -z "$p" ]] && return 0
		p="$(_sb_github_collapse_slashes "$p")"
		[[ "$p" == / ]] && { printf '/'; return 0; }
		printf '%s' "${p%/}"
	}

	_sb_github_load_roots() {
		SB_GH_ROOT="${ROOT:-}"
		SB_GH_FORK_ROOT="${FORK_ROOT:-}"

		local conf="${HOME}/.StormByte-GitHub.conf"
		if [[ -f "$conf" ]]; then
			local line key val
			while IFS= read -r line || [[ -n "$line" ]]; do
				[[ "$line" =~ ^[[:space:]]*# ]] && continue
				[[ "$line" =~ ^[[:space:]]*$ ]] && continue
				if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
					key="${BASH_REMATCH[1]}"
					val="${BASH_REMATCH[2]}"
					val="${val#\"}"
					val="${val%\"}"
					val="${val#\'}"
					val="${val%\'}"
					case "$key" in
						ROOT)
							[[ -z "$SB_GH_ROOT" ]] && SB_GH_ROOT="$val"
							;;
						FORK_ROOT)
							[[ -z "$SB_GH_FORK_ROOT" ]] && SB_GH_FORK_ROOT="$val"
							;;
					esac
				fi
			done < "$conf"
		fi

		[[ "$SB_GH_ROOT" == ~* ]] && SB_GH_ROOT="${SB_GH_ROOT/#\~/$HOME}"
		[[ "$SB_GH_FORK_ROOT" == ~* ]] && SB_GH_FORK_ROOT="${SB_GH_FORK_ROOT/#\~/$HOME}"

		[[ -z "$SB_GH_ROOT" ]] && SB_GH_ROOT="$PWD"
		[[ -z "$SB_GH_FORK_ROOT" ]] && SB_GH_FORK_ROOT="$SB_GH_ROOT"

		SB_GH_ROOT="$(_sb_github_strip_trailing_slash "$SB_GH_ROOT")"
		SB_GH_FORK_ROOT="$(_sb_github_strip_trailing_slash "$SB_GH_FORK_ROOT")"
	}

	_sb_github_repo_dirs_in() {
		local root="$1"
		local d
		local -a out=()
		root="$(_sb_github_strip_trailing_slash "$root")"
		[[ -d "$root" ]] || return 0
		shopt -s nullglob
		for d in "$root"/*/; do
			d="${d%/}"
			if [[ -d "$d/.git" || -f "$d/.git" ]]; then
				out+=("$(basename "$d")")
			fi
		done
		shopt -u nullglob
		((${#out[@]})) && printf '%s\n' "${out[@]}"
	}

	_sb_github_subdirs_in() {
		local root="$1"
		local d
		local -a out=()
		root="$(_sb_github_strip_trailing_slash "$root")"
		[[ -d "$root" ]] || return 0
		shopt -s nullglob
		for d in "$root"/*/; do
			out+=("$(basename "${d%/}")")
		done
		shopt -u nullglob
		((${#out[@]})) && printf '%s\n' "${out[@]}"
	}

	# Directory completion that behaves like bash "cd".
	# Do not combine -S / with -o filenames: readline would append a second slash.
	_sb_complete_path_dirs() {
		local cur="$1"
		local i p

		cur="$(_sb_github_collapse_slashes "$cur")"

		[[ "$cur" == "." ]] && cur="./"
		[[ "$cur" == ".." ]] && cur="../"

		mapfile -t COMPREPLY < <(compgen -d -S / -- "$cur")

		for i in "${!COMPREPLY[@]}"; do
			p="$(_sb_github_collapse_slashes "${COMPREPLY[$i]}")"
			COMPREPLY[$i]="$p"
		done

		if ((${#COMPREPLY[@]} > 0)); then
			compopt -o nospace 2>/dev/null
		fi
	}

	_sb_complete_path_files() {
		local cur="$1"
		cur="$(_sb_github_collapse_slashes "$cur")"
		mapfile -t COMPREPLY < <(compgen -f -- "$cur")
		if ((${#COMPREPLY[@]} == 1)) && [[ -d "${COMPREPLY[0]}" ]]; then
			COMPREPLY[0]="${COMPREPLY[0]%/}/"
			compopt -o nospace 2>/dev/null
		fi
	}

	# ROOT: git-repo basenames
	# PWD: every immediate subdirectory as ./name (relative path form)
	_sb_github_repo_candidates() {
		local root="$1"
		local r

		while IFS= read -r r; do
			[[ -z "$r" ]] && continue
			printf '%s\n' "$r"
		done < <(_sb_github_repo_dirs_in "$root")

		if [[ -d "$PWD" ]]; then
			while IFS= read -r r; do
				[[ -z "$r" ]] && continue
				printf '%s\n' "./$r"
			done < <(_sb_github_subdirs_in "$PWD")
		fi
	}

	_sb_is_path_cur() {
		local cur="$1"
		[[ "$cur" == ~* || "$cur" == /* || "$cur" == ./* || "$cur" == ../* \
			|| "$cur" == "./" || "$cur" == "../" || "$cur" == "." || "$cur" == ".." ]]
	}

	_sb_complete_single_repo() {
		local cur="$1"
		local root="$2"

		if _sb_is_path_cur "$cur"; then
			_sb_complete_path_dirs "$cur"
			return 0
		fi

		mapfile -t COMPREPLY < <(compgen -W "$(_sb_github_repo_candidates "$root")" -- "$cur")
	}

	_sb_complete_repo_spec() {
		local cur="$1"
		local root="$2"
		local -a repos candidates=()
		local r

		if _sb_is_path_cur "$cur"; then
			_sb_complete_path_dirs "$cur"
			return 0
		fi

		mapfile -t repos < <(_sb_github_repo_candidates "$root")

		if [[ "$cur" == '!'* ]]; then
			for r in "${repos[@]}"; do
				candidates+=("!$r")
			done
			if [[ "$cur" == *'+' ]]; then
				for r in "${repos[@]}"; do
					candidates+=("${cur}${r}")
					candidates+=("${cur}!${r}")
				done
			elif [[ "$cur" == *'+!' ]]; then
				for r in "${repos[@]}"; do
					candidates+=("${cur}${r}")
				done
			elif [[ "$cur" == *'+'* ]]; then
				for r in "${repos[@]}"; do
					candidates+=("${cur}+${r}")
					candidates+=("${cur}+!${r}")
				done
			fi
		else
			candidates=("${repos[@]}")
			for r in "${repos[@]}"; do
				candidates+=("!$r")
			done
		fi

		mapfile -t COMPREPLY < <(compgen -W "${candidates[*]}" -- "$cur")
	}

	_sb_complete_rel_path_under_repo() {
		local cur="$1"
		local repo_dir="$2"
		local i p

		[[ -d "$repo_dir" ]] || return 0
		cur="$(_sb_github_collapse_slashes "$cur")"

		mapfile -t COMPREPLY < <(
			cd "$repo_dir" 2>/dev/null || exit 0
			compgen -d -S / -- "$cur"
		)

		for i in "${!COMPREPLY[@]}"; do
			p="$(_sb_github_collapse_slashes "${COMPREPLY[$i]}")"
			COMPREPLY[$i]="$p"
		done

		if ((${#COMPREPLY[@]} > 0)); then
			compopt -o nospace 2>/dev/null
		fi
	}

	_sb_resolve_word_as_repo() {
		local w="$1"
		local root="$2"
		root="$(_sb_github_strip_trailing_slash "$root")"
		if [[ "$w" == ~* ]]; then
			w="${w/#\~/$HOME}"
		fi
		w="$(_sb_github_collapse_slashes "$w")"
		if [[ "$w" == /* || "$w" == ./* || "$w" == ../* ]]; then
			[[ -d "$w" ]] && printf '%s\n' "$(cd "$w" && pwd)"
			return
		fi
		if [[ -d "$root/$w" ]]; then
			printf '%s\n' "$(cd "$root/$w" && pwd)"
			return
		fi
		if [[ -d "$PWD/$w" ]]; then
			printf '%s\n' "$(cd "$PWD/$w" && pwd)"
		fi
	}

	_sb_complete_changelog_versions() {
		local cur="$1"
		local repo_dir="$2"
		local changelog versions=()
		local line ver

		[[ -n "$repo_dir" ]] || return 0
		changelog="$repo_dir/CHANGELOG.md"
		[[ -f "$changelog" ]] || return 0

		while IFS= read -r line; do
			[[ "$line" == *"Unreleased"* ]] && continue
			if [[ "$line" =~ ^##[[:space:]]+\[v?([0-9]+)\.([0-9]+)\.([0-9]+)([0-9A-Za-z._-]*)\] ]]; then
				ver="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.${BASH_REMATCH[3]}${BASH_REMATCH[4]}"
				versions+=("$ver")
			fi
		done < "$changelog"

		((${#versions[@]})) || return 0
		mapfile -t COMPREPLY < <(compgen -W "${versions[*]}" -- "$cur")
	}

	_sb_complete_submodule_names() {
		local cur="$1"
		local repo_dir="$2"
		local names=()
		local line name

		[[ -n "$repo_dir" && -f "$repo_dir/.gitmodules" ]] || return 0
		while IFS= read -r line; do
			if [[ "$line" =~ ^[[:space:]]*\[submodule[[:space:]]+\"([^\"]+)\" ]]; then
				names+=("${BASH_REMATCH[1]}")
			fi
		done < "$repo_dir/.gitmodules"
		((${#names[@]})) || return 0
		mapfile -t COMPREPLY < <(compgen -W "${names[*]}" -- "$cur")
	}

	_sb_github_load_roots

	if ((cword == 1)); then
		mapfile -t COMPREPLY < <(compgen -W "${top_cmds[*]}" -- "$cur")
		return 0
	fi

	cmd="${words[1]-}"

	case "$cmd" in
	help | -h | --help)
		return 0
		;;

	cache)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${cache_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		show | list | delete)
			if [[ "$prev" == --name || "$cur" == --name=* ]]; then
				return 0
			fi
			if [[ "$cur" == -* ]]; then
				if ! _sb_github_has_word --name; then
					mapfile -t COMPREPLY < <(compgen -W "--name" -- "$cur")
				fi
				return 0
			fi
			_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
			if ! _sb_github_has_word --name; then
				local -a extra=()
				mapfile -t extra < <(compgen -W "--name" -- "$cur")
				COMPREPLY+=("${extra[@]}")
			fi
			;;
		esac
		return 0
		;;

	ci)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${ci_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		start | restart)
			if [[ "$cur" == -* ]]; then
				if ! _sb_github_has_word --failed; then
					mapfile -t COMPREPLY < <(compgen -W "--failed" -- "$cur")
				fi
			else
				_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
			fi
			;;
		stop | status)
			_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
			;;
		esac
		return 0
		;;

	submodules)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${submodules_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		init | deinit | list)
			_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
			return 0
			;;
		update)
			if [[ "$cur" == -* ]]; then
				mapfile -t COMPREPLY < <(compgen -W "--confirm --latest" -- "$cur")
				return 0
			fi
			_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
			local -a extra=()
			mapfile -t extra < <(compgen -W "--confirm --latest" -- "$cur")
			COMPREPLY+=("${extra[@]}")
			return 0
			;;
		add)
			if [[ "$cur" == --name=* ]]; then
				return 0
			fi
			if [[ "$prev" == --name ]]; then
				return 0
			fi
			if [[ "$cur" == -* ]]; then
				if ! _sb_github_has_word --name && ! _sb_github_has_word --name=*; then
					mapfile -t COMPREPLY < <(compgen -W "--name" -- "$cur")
				fi
				return 0
			fi

			local i have_name=0
			local -a pos=()
			for ((i = 3; i < cword; i++)); do
				case "${words[i]}" in
					--name)
						have_name=1
						if ((i + 1 < cword)); then
							((++i))
						fi
						;;
					--name=*)
						have_name=1
						;;
					-*)
						;;
					*)
						pos+=("${words[i]}")
						;;
				esac
			done

			local repo_dir=""
			local -a extra=()

			case ${#pos[@]} in
				0)
					_sb_complete_single_repo "$cur" "$SB_GH_ROOT"
					if [[ "$have_name" -eq 0 ]]; then
						mapfile -t extra < <(compgen -W "--name" -- "$cur")
						COMPREPLY+=("${extra[@]}")
					fi
					;;
				1)
					COMPREPLY=()
					if [[ "$have_name" -eq 0 && "$cur" == -* ]]; then
						mapfile -t COMPREPLY < <(compgen -W "--name" -- "$cur")
					fi
					;;
				2)
					repo_dir="$(_sb_resolve_word_as_repo "${pos[0]}" "$SB_GH_ROOT")"
					COMPREPLY=()
					if [[ -n "$repo_dir" ]]; then
						_sb_complete_rel_path_under_repo "$cur" "$repo_dir"
					fi
					if [[ "$have_name" -eq 0 ]]; then
						mapfile -t extra < <(compgen -W "--name" -- "$cur")
						COMPREPLY+=("${extra[@]}")
					fi
					;;
				*)
					if [[ "$have_name" -eq 0 ]]; then
						mapfile -t COMPREPLY < <(compgen -W "--name" -- "$cur")
					fi
					;;
			esac
			return 0
			;;
		delete)
			if [[ "$cur" == --name=* || "$cur" == --url=* || "$cur" == --path=* ]]; then
				return 0
			fi
			if [[ "$cur" == -* ]]; then
				mapfile -t COMPREPLY < <(compgen -W "--name --url --path" -- "$cur")
				return 0
			fi
			if [[ "$prev" == --url ]]; then
				return 0
			fi
			if [[ "$prev" == --name ]]; then
				local i repo_dir=""
				for ((i = 3; i < cword; i++)); do
					case "${words[i]}" in
						--name|--url|--path) ((i++)) ;;
						--name=*|--url=*|--path=*) ;;
						-*) ;;
						*)
							repo_dir="$(_sb_resolve_word_as_repo "${words[i]}" "$SB_GH_ROOT")"
							[[ -n "$repo_dir" ]] && break
							;;
					esac
				done
				_sb_complete_submodule_names "$cur" "$repo_dir"
				return 0
			fi
			if [[ "$prev" == --path ]]; then
				local i repo_dir=""
				for ((i = 3; i < cword; i++)); do
					case "${words[i]}" in
						--name|--url|--path) ((i++)) ;;
						--name=*|--url=*|--path=*) ;;
						-*) ;;
						*)
							repo_dir="$(_sb_resolve_word_as_repo "${words[i]}" "$SB_GH_ROOT")"
							[[ -n "$repo_dir" ]] && break
							;;
					esac
				done
				if [[ -n "$repo_dir" ]]; then
					_sb_complete_rel_path_under_repo "$cur" "$repo_dir"
				fi
				return 0
			fi

			local i have_dir=0
			for ((i = 3; i < cword; i++)); do
				case "${words[i]}" in
					--name|--url|--path) ((i++)) ;;
					--name=*|--url=*|--path=*) ;;
					-*) ;;
					*)
						have_dir=1
						;;
				esac
			done
			if [[ "$have_dir" -eq 0 ]]; then
				_sb_complete_single_repo "$cur" "$SB_GH_ROOT"
			else
				mapfile -t COMPREPLY < <(compgen -W "--name --url --path" -- "$cur")
			fi
			return 0
			;;
		esac
		return 0
		;;

	git)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${git_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		reset | pull | sync)
			_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
			;;
		esac
		return 0
		;;

	repos)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${repos_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		list)
			return 0
			;;
		dump)
			if ((cword == 3)); then
				if _sb_is_path_cur "$cur"; then
					_sb_complete_path_dirs "$cur"
				else
					local -a dump_cands=()
					local d
					while IFS= read -r d; do
						[[ -n "$d" ]] && dump_cands+=("$d")
					done < <(_sb_github_subdirs_in "$SB_GH_ROOT")
					while IFS= read -r d; do
						[[ -n "$d" ]] && dump_cands+=("./$d")
					done < <(_sb_github_subdirs_in "$PWD")
					mapfile -t COMPREPLY < <(compgen -W "${dump_cands[*]}" -- "$cur")
				fi
				return 0
			fi
			if [[ "$cur" == type=* || "$cur" == type ]]; then
				mapfile -t COMPREPLY < <(compgen -W 'type=c++ type=cmake' -- "$cur")
				return 0
			fi
			mapfile -t COMPREPLY < <(compgen -W "${dump_extra[*]}" -- "$cur")
			return 0
			;;
		status | push)
			_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
			return 0
			;;
		release)
			if [[ "$cur" == -* ]]; then
				local -a rel_flags=()
				_sb_github_has_word --list    || rel_flags+=(--list)
				_sb_github_has_word --delete  || rel_flags+=(--delete)
				_sb_github_has_word --skip-ci || rel_flags+=(--skip-ci)
				mapfile -t COMPREPLY < <(compgen -W "${rel_flags[*]}" -- "$cur")
				return 0
			fi

			local i have_list=0 have_delete=0
			local -a pos=()
			for ((i = 3; i < cword; i++)); do
				case "${words[i]}" in
					--list)    have_list=1 ;;
					--delete)  have_delete=1 ;;
					--skip-ci) ;;
					-*) ;;
					*) pos+=("${words[i]}") ;;
				esac
			done

			# --list walks ROOT / dir-spec / !exclusions (same as foreach_repo)
			if [[ "$have_list" -eq 1 ]]; then
				case ${#pos[@]} in
					0)
						_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
						;;
					1)
						local repo_dir=""
						repo_dir="$(_sb_resolve_word_as_repo "${pos[0]}" "$SB_GH_ROOT")"
						if [[ -n "$repo_dir" ]]; then
							_sb_complete_changelog_versions "$cur" "$repo_dir"
						else
							COMPREPLY=()
						fi
						;;
					*)
						COMPREPLY=()
						;;
				esac
				return 0
			fi

			# create / delete: first token is a single repo (not !spec)
			if [[ ${#pos[@]} -eq 0 ]]; then
				_sb_complete_single_repo "$cur" "$SB_GH_ROOT"
				return 0
			fi
			if [[ ${#pos[@]} -eq 1 ]]; then
				local repo_dir
				local -a extra=()
				repo_dir="$(_sb_resolve_word_as_repo "${pos[0]}" "$SB_GH_ROOT")"
				if [[ -n "$repo_dir" ]]; then
					_sb_complete_changelog_versions "$cur" "$repo_dir"
				fi
				mapfile -t extra < <(compgen -W "--list --delete --skip-ci" -- "$cur")
				COMPREPLY+=("${extra[@]}")
				return 0
			fi
			COMPREPLY=()
			return 0
			;;
		esac
		return 0
		;;

	clone-all)
		return 0
		;;

	search)
		if ((cword == 2)); then
			return 0
		fi
		_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
		return 0
		;;

	fork)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${fork_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		status | sync | branch-status)
			_sb_complete_repo_spec "$cur" "$SB_GH_FORK_ROOT"
			;;
		esac
		return 0
		;;

	test)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${test_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		asan | tsan)
			if [[ "$cur" == -* ]]; then
				local -a flags=()
				_sb_github_has_word --builddir      || flags+=(--builddir)
				_sb_github_has_word --testdir       || flags+=(--testdir)
				_sb_github_has_word --outfile       || flags+=(--outfile)
				_sb_github_has_word --cmake-options || flags+=(--cmake-options)
				_sb_github_has_word --executable    || flags+=(--executable)
				_sb_github_has_word --test          || flags+=(--test)
				_sb_github_has_word --verbose       || flags+=(--verbose)
				if [[ "$sub" == asan ]]; then
					_sb_github_has_word --asan-options || flags+=(--asan-options)
				else
					_sb_github_has_word --tsan-options || flags+=(--tsan-options)
				fi
				mapfile -t COMPREPLY < <(compgen -W "${flags[*]}" -- "$cur")
				return 0
			fi

			case "$prev" in
				--builddir|--testdir)
					_sb_complete_path_dirs "$cur"
					return 0
					;;
				--outfile|--executable)
					_sb_complete_path_files "$cur"
					return 0
					;;
				--cmake-options|--test|--asan-options|--tsan-options)
					return 0
					;;
			esac

			_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
			;;
		esac
		return 0
		;;
	esac
}

complete -F _StormByte_GitHub StormByte-GitHub
